        display:flex; justify-content:space-between; align-items:center;
        cursor:pointer; font-weight:bold; border-radius:4px 4px 0 0;">
        <span>☁️ CONTAGEM EVENTOS <span id="nuvens-count" style="background:#000;color:#00bcd4;padding:1px 6px;border-radius:10px;margin-left:6px;">0</span></span>
        <span id="nuvens-toggle">▼</span>
    </div>
    <div id="nuvens-body" style="padding:8px;">
        <div style="display:flex;gap:6px;margin-bottom:8px;">
            <input id="nuvens-input" type="text" value="OVC|BKN" onkeydown="if(event.key==='Enter') fetchNuvens()" style="
                flex:1; background:#2a2a2a; border:1px solid #00bcd4;
                color:#fff; padding:4px 6px; border-radius:4px; font-family:monospace; font-size:12px;"/>
            <button onclick="fetchNuvens()" style="
                background:#00bcd4; color:#000; border:none;
                padding:4px 10px; border-radius:4px; cursor:pointer; font-weight:bold;">▶</button>
        </div>
        <div id="nuvens-list" style="max-height:300px;overflow-y:auto;">
            <div style="color:#888;text-align:center;padding:10px;">Aguardando...</div>
        </div>
    </div>
</div>

<script>
(function() {
    let minimized = false;
    document.getElementById('nuvens-header').addEventListener('click', e => {
        if (e.target.closest('input,button')) return;
        minimized = !minimized;
        document.getElementById('nuvens-body').style.display = minimized ? 'none' : 'block';
        document.getElementById('nuvens-toggle').textContent = minimized ? '▲' : '▼';
    });

    // Drag
    const panel = document.getElementById('nuvens-panel');
    const header = document.getElementById('nuvens-header');
    let dragging = false, ox = 0, oy = 0;
    header.addEventListener('mousedown', e => {
        if (e.target.closest('input,button')) return;
        dragging = true;
        ox = e.clientX - panel.getBoundingClientRect().left;
        oy = e.clientY - panel.getBoundingClientRect().top;
        e.preventDefault();
    });
    document.addEventListener('mousemove', e => {
        if (!dragging) return;
        panel.style.left = (e.clientX - ox) + 'px';
        panel.style.top  = (e.clientY - oy) + 'px';
        panel.style.bottom = 'auto';
    });
    document.addEventListener('mouseup', () => dragging = false);

    const TERMOS = {
        'rajada':     'G\\d+KT',
        'trovoada':   'TS',
        'nevoeiro':   'FG',
        'nevoa':      'BR',
        'chuva':      'RA|SH',
        'variavel':   '\\d{3}V\\d{3}',
        'congelante': 'FZ',
    };

    window.fetchNuvens = async function() {
        let tipo = document.getElementById('nuvens-input').value.trim() || 'OVC|BKN';
        tipo = TERMOS[tipo.toLowerCase()] || tipo;
        const btn = document.querySelector('#nuvens-panel button');
        btn.textContent = '⏳'; btn.disabled = true;
        try {
            const res = await fetch('/nuvens/contagem?tipo=' + encodeURIComponent(tipo));
            const d = await res.json();
            document.getElementById('nuvens-count').textContent = d.total ?? 0;
            const list = document.getElementById('nuvens-list');
            if (d.erro) { list.innerHTML = `<div style="color:#f44">${d.erro}</div>`; return; }
            if (!d.aerodromos?.length) { list.innerHTML = '<div style="color:#888;text-align:center;padding:10px;">Nenhum resultado</div>'; return; }
            list.innerHTML = d.aerodromos.map(a =>
                `<div style="border-left:3px solid #00bcd4;padding:4px 8px;margin-bottom:4px;background:#0a2a2a;border-radius:0 4px 4px 0;">
                    <div style="color:#00bcd4;font-weight:bold;">${a.icao} <span style="color:#aaa;font-size:11px;">${a.condicao}</span></div>
                    <div style="color:#ccc;font-size:10px;word-break:break-all;">${a.metar}</div>
                </div>`
            ).join('');
        } catch(e) { console.error('Erro nuvens:', e); }
        finally { btn.textContent = '▶'; btn.disabled = false; }
    };

    fetchNuvens();
    setInterval(fetchNuvens, 60000);
})();
</script>

</body>
</html>

        async function toggleCanal16Animation() {
            console.log('Botão animação Canal 16 clicado!');
            if (isCanal16Animating) {
                stopCanal16Animation();
                return;
            }

            try {
                console.log('Fazendo fetch para /canal16frames...');
                // Buscar lista de frames do Canal 16
                const response = await fetch('/canal16frames');
                console.log('Response status:', response.status);
                console.log('Response ok:', response.ok);
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const data = await response.json();
                console.log('Data recebida:', data);
                
                // Extrair array de frames (compatível com formato {frames: [...]} ou [...])
                const allFrames = Array.isArray(data) ? data : (data.frames || []);
                
                // Pegar apenas as últimas 8 imagens (mais recentes)
                canal16AnimationFrames = allFrames.slice(-8);
                
                if (canal16AnimationFrames.length === 0) {
                    alert('Nenhum frame do Canal 16 disponível para animação');
                    return;
                }
                
                console.log('Frames Canal 16 carregados (últimas 8):', canal16AnimationFrames.length);
                canal16CurrentFrame = 0;
                isCanal16Animating = true;
                
                // Pré-criar sources uma única vez — evita request repetido a cada tick
                canal16PreloadedSources = canal16AnimationFrames.map(canal16MakeSource);
                
                // Mostrar camada Canal 16 se não estiver visível
                canal16Layer.setVisible(true);
                
                // Atualizar lista de frames a cada 2 minutos durante a animação
                canal16FrameUpdateInterval = setInterval(async () => {
                    try {
                        const response = await fetch('/canal16frames');
                        const data = await response.json();
                        const newFrames = Array.isArray(data) ? data : (data.frames || []);
                        const newSlice = newFrames.slice(-8);

                        if (newSlice.length === 0) return;

                        const lastKnown = canal16AnimationFrames[canal16AnimationFrames.length - 1];
                        const lastNew   = newSlice[newSlice.length - 1];

                        if (lastNew !== lastKnown) {
                            const knownSet = new Set(canal16AnimationFrames);
                            const toAdd = newSlice.filter(f => !knownSet.has(f));
                            if (toAdd.length > 0) {
                                canal16AnimationFrames = [...canal16AnimationFrames, ...toAdd].slice(-8);
                                canal16PreloadedSources = [...canal16PreloadedSources, ...toAdd.map(canal16MakeSource)].slice(-8);
                                console.log('✅ Canal 16: ' + toAdd.length + ' frame(s) novo(s) adicionado(s) ao final');
                            }
                        }
                    } catch (error) {
                        console.log('Erro ao atualizar frames:', error);
                    }
                }, 120000); // 2 minutos
                
                // Iniciar loop de animação — só troca referência, sem criar novo source
                canal16AnimationInterval = setInterval(() => {
                    if (canal16PreloadedSources.length > 0) {
                        canal16Layer.setSource(canal16PreloadedSources[canal16CurrentFrame]);
                        canal16CurrentFrame = (canal16CurrentFrame + 1) % canal16PreloadedSources.length;
                    }
                }, 800); // 800ms entre frames
                
                console.log('Animação Canal 16 iniciada com atualização automática');
                
            } catch (error) {
                console.error('Erro ao iniciar animação Canal 16:', error);
                alert('Erro ao carregar frames do Canal 16');
            }
        }


        }

        function sendSigmetMessage(coordsJson, severity, flightLevel) {
            const coords = JSON.parse(coordsJson);
            
            const payload = {
                coordinates: coords,
                severity: severity,
                flightLevel: flightLevel,
                timestamp: new Date().toISOString()
            };
            
            console.log('📤 Enviando SIGMET:', payload);
            
            fetch('/create_sigmet', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                console.log('✅ SIGMET enviado:', data);
                alert('SIGMET enviado com sucesso! ID: ' + data.id);
            })
            .catch(error => {
                console.error('❌ Erro ao enviar SIGMET:', error);

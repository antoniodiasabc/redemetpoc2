        async function loadTopSB(limit, layerPrefix) {
            try {
                let endpoint;
                if (limit === 20) endpoint = '/metar_top20_sb';
                else if (limit === 50) endpoint = '/metar_top50_sb';
                else if (limit === 200) endpoint = '/metar_top200_sb';
                else endpoint = '/metar_top20_sb';
                
                // Cache busting para forçar dados novos
                const cacheBuster = '?t=' + Date.now();
                const response = await fetch(endpoint + cacheBuster);
                const airports = await response.json();
                
                const currentLayer = window[layerPrefix + 'Layer'];
                if (currentLayer) {
                    map.removeLayer(currentLayer);
                }
                
                const features = airports.map(airport => {
                    return new ol.Feature({
                        geometry: new ol.geom.Point(ol.proj.fromLonLat([airport.lon, airport.lat])),
                        icao: airport.icao,
                        nome: airport.nome,
                        condition: airport.condition,
                        color: airport.color,
                        metarText: airport.metarText,
                        tafText: airport.tafText,
                        hasAviso: airport.hasAviso,
                        isSpeci: airport.isSpeci
                    });
                });
                
                const newLayer = new ol.layer.Vector({
                    source: new ol.source.Vector({ features: features }),
                    style: function(feature) {
                        const props = feature.getProperties();
                        const styles = [];
                        
                        styles.push(new ol.style.Style({
                            image: new ol.style.Circle({
                                radius: 8,
                                fill: new ol.style.Fill({ color: props.color })
                            }),
                            text: new ol.style.Text({
                                text: props.icao,
                                font: '12px Arial',
                                fill: new ol.style.Fill({ color: '#000' }),
                                stroke: new ol.style.Stroke({ color: '#FFF', width: 2 }),
                                offsetY: -20
                            })
                        }));
                        
                        if (props.hasAviso) {
                            function createHatchPattern() {
                                const canvas = document.createElement('canvas');
                                canvas.width = 8; canvas.height = 8;
                                const ctx = canvas.getContext('2d');
                                ctx.clearRect(0, 0, 8, 8);
                                ctx.strokeStyle = props.color === '#FF0000' ? '#FFFFFF' : '#FF0000'; ctx.lineWidth = 1;
                                ctx.beginPath();
                                ctx.moveTo(0, 4); ctx.lineTo(8, 4);
                                ctx.moveTo(4, 0); ctx.lineTo(4, 8);
                                ctx.stroke();
                                return ctx.createPattern(canvas, 'repeat');
                            }
                            
                            styles.push(new ol.style.Style({
                                image: new ol.style.Circle({
                                    radius: 8,
                                    fill: new ol.style.Fill({ color: createHatchPattern() })
                                })
                            }));
                        }
                        
                        if (props.isSpeci) {
                            styles.push(new ol.style.Style({
                                image: new ol.style.Circle({

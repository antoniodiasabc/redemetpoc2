                    fill: new ol.style.Fill({
                        color: '#ffcc33'
                    })
                })
            })
        });

        // SIGMET Layer
        sigmetLayer = new ol.layer.Vector({
            source: new ol.source.Vector(),
            style: function(feature) {
                const fir = feature.get('fir');
                const colors = {
                    'SBAZ': 'rgba(255,0,0,0.3)',
                    'SBAO': 'rgba(0,255,0,0.3)', 
                    'SBBS': 'rgba(0,0,255,0.3)',
                    'SBCW': 'rgba(255,255,0,0.3)',
                    'SBRE': 'rgba(255,0,255,0.3)'
                };
                return new ol.style.Style({
                    stroke: new ol.style.Stroke({ color: colors[fir] || 'red', width: 4 }),
                    fill: new ol.style.Fill({ color: colors[fir] || 'rgba(255,0,0,0.3)' })
                });
            },
            visible: false
        });

        airmetLayer = new ol.layer.Vector({
            source: new ol.source.Vector(),
            visible: false
        });

        // Layer SIGMETs Vizinhos
        sigmetVizinhosLayer = new ol.layer.Vector({
            source: new ol.source.Vector(),
            style: function(feature) {
                const color = feature.get('color') || '#FF6600';
                const rgb = color.replace('#','');
                const r = parseInt(rgb.substring(0,2),16), g = parseInt(rgb.substring(2,4),16), b = parseInt(rgb.substring(4,6),16);
                return new ol.style.Style({
                    stroke: new ol.style.Stroke({ color: color, width: 2, lineDash: [6,3] }),
                    fill: new ol.style.Fill({ color: `rgba(${r},${g},${b},0.15)` })

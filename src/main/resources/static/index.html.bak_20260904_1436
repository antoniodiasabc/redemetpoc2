        function processHSVSimpleFeatures(features) {
            console.log('Total features no JSON:', features.length);
            
            // FILTRO PRINCIPAL: Polígonos SIGMET ou SEVERA
            const sigmetPolygons = features.filter(feature => 
                feature.geometry.type === 'Polygon' && 
                (feature.properties.sigmet === true || feature.properties.severity === 'SEVERA')
            );
            console.log('Polígonos SIGMET encontrados:', sigmetPolygons.length);
            
            // FILTRO SEVERIDADE: Só SEVERA para SIGMET
            const severePolygons = sigmetPolygons.filter(feature =>
                feature.properties.severity === 'SEVERA'
            );
            console.log('Polígonos SEVERA:', severePolygons.length);
            
            // AGRUPAR quadrados próximos e criar contorno
            const clusters = clusterNearbyFeatures(severePolygons);
            console.log('Clusters criados:', clusters.length);
            
            // Converter clusters em polígonos contornados
            const polygons = clusters.map(cluster => {
                const contour = createContourFromCluster(cluster);
                return {
                    coordinates: contour,
                    severity: 'severa',
                    area: cluster.length * 0.1,
                    pixelCount: cluster.reduce((sum, f) => sum + f.properties.pixels, 0)
                };
            });
            
            console.log('Polígonos contornados:', polygons.length);
            return polygons;
        }

        function createContourFromCluster(cluster) {
            // Coletar todos os pontos dos quadrados
            const allPoints = [];
            cluster.forEach(feature => {
                const coords = feature.geometry.coordinates[0];
                coords.forEach(point => allPoints.push(point));
            });
            
            // Criar envoltória convexa (contorno externo)
            const hull = convexHull(allPoints);
            return hull;
        }

        function convexHull(points) {
            if (points.length < 3) return points;
            
            // Algoritmo simples de envoltória convexa
            points.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
            
            const lower = [];
            for (let i = 0; i < points.length; i++) {
                while (lower.length >= 2 && cross(lower[lower.length-2], lower[lower.length-1], points[i]) <= 0) {
                    lower.pop();
                }
                lower.push(points[i]);
            }
            
            const upper = [];
            for (let i = points.length - 1; i >= 0; i--) {
                while (upper.length >= 2 && cross(upper[upper.length-2], upper[upper.length-1], points[i]) <= 0) {
                    upper.pop();
                }
                upper.push(points[i]);
            }
            
            upper.pop();
            lower.pop();
            return lower.concat(upper);
        }

        function cross(o, a, b) {
            return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
        }

        function groupFeaturesBySeverity(features) {
            const groups = {};
            
            features.forEach(feature => {
                const severity = feature.properties.severity.toLowerCase();
                if (!groups[severity]) {
                    groups[severity] = [];
                }
                groups[severity].push(feature);
            });
            
            return groups;
        }

        function clusterNearbyFeatures(features) {
            const clusters = [];
            const used = new Set();
            
            features.forEach((feature, index) => {
                if (used.has(index)) return;
                
                const cluster = [feature];
                used.add(index);
                
                // Buscar features SEVERA próximas (distância pequena)
                features.forEach((otherFeature, otherIndex) => {
                    if (used.has(otherIndex)) return;
                    
                    const distance = calculateFeatureDistance(feature, otherFeature);
                    if (distance < 0.2) { // 0.2 graus = ~22km (bem próximo)
                        cluster.push(otherFeature);
                        used.add(otherIndex);
                    }
                });
                
                // Só criar cluster se tiver pelo menos 1 feature
                if (cluster.length > 0) {
                    clusters.push(cluster);
                }
            });
            
            console.log('Clusters SEVERA criados:', clusters.length);
            return clusters;
        }

        function calculateFeatureDistance(feature1, feature2) {
            const center1 = calculateFeatureCenter(feature1);
            const center2 = calculateFeatureCenter(feature2);
            
            return Math.sqrt(Math.pow(center1[0] - center2[0], 2) + Math.pow(center1[1] - center2[1], 2));
        }

        function calculateFeatureCenter(feature) {
            const coords = feature.geometry.coordinates[0];
            let sumLon = 0, sumLat = 0;
            
            coords.forEach(coord => {
                sumLon += coord[0];
                sumLat += coord[1];
            });
            
            return [sumLon / coords.length, sumLat / coords.length];
        }

        function createPolygonFromFeatureCluster(cluster, severity) {
            // Usar só o primeiro feature como base (não todos os pontos)
            const baseFeature = cluster[0];
            const baseCoords = baseFeature.geometry.coordinates[0];
            
            // Calcular bounding box local do cluster
            let minLon = baseCoords[0][0], maxLon = baseCoords[0][0];
            let minLat = baseCoords[0][1], maxLat = baseCoords[0][1];
            
            cluster.forEach(feature => {
                const coords = feature.geometry.coordinates[0];
                coords.forEach(coord => {
                    minLon = Math.min(minLon, coord[0]);
                    maxLon = Math.max(maxLon, coord[0]);
                    minLat = Math.min(minLat, coord[1]);
                    maxLat = Math.max(maxLat, coord[1]);
                });
            });
            
            // Criar polígono simples com 8 pontos do bounding box
            const finalPoints = [
                [minLon, minLat],                           // SW
                [(minLon + maxLon) / 2, minLat],           // S
                [maxLon, minLat],                          // SE
                [maxLon, (minLat + maxLat) / 2],          // E
                [maxLon, maxLat],                          // NE
                [(minLon + maxLon) / 2, maxLat],          // N
                [minLon, maxLat],                          // NW
                [minLon, (minLat + maxLat) / 2]           // W
            ];
            
            return {
                coordinates: finalPoints,
                severity: severity,
                area: calculatePolygonArea(finalPoints),
                pixelCount: cluster.length
            };
        }

        function convexHull(points) {
            if (points.length < 3) return points;
            
            // Algoritmo Graham Scan simplificado
            // Encontrar ponto mais baixo
            let start = points[0];
            for (let point of points) {
                if (point[1] < start[1] || (point[1] === start[1] && point[0] < start[0])) {
                    start = point;
                }
            }
            
            // Para simplificar, usar bounding box como aproximação
            let minLon = start[0], maxLon = start[0];
            let minLat = start[1], maxLat = start[1];
            
            for (let point of points) {
                minLon = Math.min(minLon, point[0]);
                maxLon = Math.max(maxLon, point[0]);
                minLat = Math.min(minLat, point[1]);
                maxLat = Math.max(maxLat, point[1]);
            }
            
            // Retornar 8 pontos do contorno
            return [
                [minLon, minLat],
                [(minLon + maxLon) / 2, minLat],
                [maxLon, minLat],
                [maxLon, (minLat + maxLat) / 2],
                [maxLon, maxLat],
                [(minLon + maxLon) / 2, maxLat],
                [minLon, maxLat],
                [minLon, (minLat + maxLat) / 2]
            ];
        }

        function adjustPointCount(points) {
            // Garantir entre 5 e 15 pontos
            if (points.length < 5) {
                // Adicionar pontos intermediários
                while (points.length < 5) {
                    const newPoints = [];
                    for (let i = 0; i < points.length; i++) {
                        newPoints.push(points[i]);
                        if (newPoints.length < 15) {
                            const nextIndex = (i + 1) % points.length;
                            const midPoint = [
                                (points[i][0] + points[nextIndex][0]) / 2,
                                (points[i][1] + points[nextIndex][1]) / 2
                            ];
                            newPoints.push(midPoint);
                        }
                    }
                    points = newPoints;
                }
            } else if (points.length > 15) {
                // Simplificar removendo pontos
                const step = Math.ceil(points.length / 10);
                const simplified = [];
                for (let i = 0; i < points.length; i += step) {
                    simplified.push(points[i]);
                }
                points = simplified;
            }
            
            return points.slice(0, 15); // Garantir máximo 15
        }

        function calculatePolygonArea(points) {
            if (points.length < 3) return 0;
            let area = 0;
            for (let i = 0; i < points.length; i++) {
                const j = (i + 1) % points.length;
                area += points[i][0] * points[j][1];
                area -= points[j][0] * points[i][1];
            }
            return Math.abs(area) / 2;
        }

        function createEditableVectorLayer(polygons) {
            const features = [];
            
            // Offset fixo baseado no teste (offset completo)
            const OFFSET_LON = 1.124394;   // offset completo
            const OFFSET_LAT = -4.211094;  // offset completo
            
            polygons.forEach(polygon => {
                // Aplicar offset nas coordenadas
                const coordsWithOffset = polygon.coordinates.map(coord => [
                    coord[0] + OFFSET_LON,
                    coord[1] + OFFSET_LAT
                ]);
                
                // Converter coordenadas para projeção do mapa
                const coords = coordsWithOffset.map(coord => ol.proj.fromLonLat(coord));
                
                // Criar geometria
                const geometry = new ol.geom.Polygon([coords]);
                
                // Criar feature
                const feature = new ol.Feature({
                    geometry: geometry,
                    severity: polygon.severity,
                    area: polygon.area,
                    pixelCount: polygon.pixelCount,
                    pointCount: polygon.coordinates.length
                });
                
                features.push(feature);
            });
            
            // Criar source
            const source = new ol.source.Vector({
                features: features
            });
            
            // Criar layer com estilos
            const layer = new ol.layer.Vector({
                source: source,
                style: function(feature) {
                    const severity = feature.get('severity');
                    let color;
                    
                    switch(severity) {
                        case 'severa': color = 'rgba(255, 102, 0, 0.6)'; break;  // Laranja
                        case 'forte': color = 'rgba(153, 0, 255, 0.6)'; break;   // Roxo
                        case 'moderada': color = 'rgba(0, 255, 0, 0.6)'; break;  // Verde
                        default: color = 'rgba(255, 0, 0, 0.6)';
                    }
                    
                    return new ol.style.Style({
                        fill: new ol.style.Fill({
                            color: color
                        }),
                        stroke: new ol.style.Stroke({
                            color: severity === 'severa' ? '#FF6600' : (severity === 'forte' ? '#9900FF' : '#00FF00'),
                            width: 4
                        })
                    });
                }
            });
            
            return layer;
        }

        function setupEditInteractions(vectorLayer) {
            console.log('🔧 Configurando interações de edição...');
            
            // Select interaction
            const select = new ol.interaction.Select({
                layers: [vectorLayer],
                style: new ol.style.Style({

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema Meteorológico</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@8.2.0/ol.css">
    <style>
        #map { width: 100%; height: 100vh; }
        body { margin: 0; font-family: Arial; }
        .controls { margin: 10px 0; }
        button { margin: 5px; padding: 8px 12px; }
        .sigmet-btn { background-color: #4CAF50; color: white; border: none; border-radius: 4px; }
        .sigmet-btn.active { background-color: #45a049; }
        .sigmet-btn:disabled { background-color: #cccccc; }
        
        /* Popup para polígonos */
        .ol-popup {
            position: relative;
            background-color: white;
            border: 2px solid #cccccc;
            border-radius: 10px;
            padding: 15px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.2);
            max-width: 400px;
            font-family: Arial, sans-serif;
        }

        .ol-popup table {
            font-size: 12px;
        }

        .ol-popup th, .ol-popup td {
            border: 1px solid #ccc;
            padding: 4px;
            text-align: center;
        }

        .ol-popup:after {
            top: 100%;
            border: solid transparent;
            content: " ";
            height: 0;
            width: 0;
            position: absolute;
            pointer-events: none;
            border-color: rgba(255, 255, 255, 0);
            border-top-color: white;
            border-width: 10px;
            left: 48px;
            margin-left: -10px;
        }
        
        /* Formulário SIGMET */
        #sigmetForm {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            border: 2px solid #333;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            z-index: 1000;
            width: 400px;
            max-height: 80vh;
            overflow-y: auto;
        }
        
        #sigmetForm h3 {
            margin-top: 0;
            color: #333;
            text-align: center;
        }
        
        #sigmetForm .form-group {
            margin-bottom: 15px;
        }
        
        #sigmetForm label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: #555;
        }
        
        #sigmetForm select, #sigmetForm textarea {
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 14px;
            box-sizing: border-box;
        }
        
        #sigmetForm textarea {
            height: 80px;
            resize: vertical;
        }
        
        #sigmetForm .coords-display {
            background: #f5f5f5;
            padding: 10px;
            border-radius: 4px;
            font-family: monospace;
            font-size: 12px;
            max-height: 100px;
            overflow-y: auto;
        }
        
        #sigmetForm .buttons {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        
        #sigmetForm button {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
        }
        
        #sigmetForm .btn-submit {
            background: #007cba;
            color: white;
        }
        
        #sigmetForm .btn-submit:hover {
            background: #005a87;
        }
        
        #sigmetForm .btn-cancel {
            background: #666;
            color: white;
        }
        
        #sigmetForm .btn-cancel:hover {
            background: #444;
        }
        
        .custom-mouse-position {
            position: fixed !important;
            top: 10px !important;
            right: 60px !important;
            background: rgba(0,0,0,0.7) !important;
            color: white !important;
            padding: 5px !important;
            border-radius: 3px !important;
            font-family: monospace !important;
            z-index: 1002 !important;
        }
        
        @media (max-width: 768px) {
            .custom-mouse-position {
                right: 10px !important;
                top: 60px !important;
                font-size: 12px !important;
            }
        }
    </style>
    <script src="https://cesium.com/downloads/cesiumjs/releases/1.114/Build/Cesium/Cesium.js"></script>
    <link href="https://cesium.com/downloads/cesiumjs/releases/1.114/Build/Cesium/Widgets/widgets.css" rel="stylesheet">
    <script src="/js/olcs.js"></script>
</head>
<body>
    <!-- Menu Principal Minimizável -->
    <div style="position: fixed; top: 10px; left: 35%; transform: translateX(-50%); z-index: 1000;">
        <button id="mainMenuToggle" onclick="toggleMainMenu()" style="background: rgba(96, 125, 139, 0.95); color: white; border: none; padding: 8px 15px; border-radius: 8px; cursor: pointer; font-size: 14px; box-shadow: 0 4px 20px rgba(0,0,0,0.2); backdrop-filter: blur(5px); border: 1px solid rgba(255,255,255,0.2);">
            📋 Menu ▼
        </button>
        
        <div id="main-controls" style="display: none; margin-top: 8px;">
            <div class="controls" style="display: flex; gap: 8px; flex-wrap: wrap; background: rgba(255,255,255,0.95); backdrop-filter: blur(5px); padding: 8px 12px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); border: 1px solid rgba(255,255,255,0.2); max-width: 90vw; overflow-x: auto;">
                <!-- Seção Camadas Base -->
                <div class="section" style="flex: 1; min-width: 180px; max-width: 22%;">
                    <button onclick="toggleSection('base-layers')" style="background: #4CAF50; color: white; border: none; padding: 4px 8px; border-radius: 6px; cursor: pointer; margin-bottom: 4px; width: 100%; font-size: 11px;">
                        🛰️ Camadas ▼
                    </button>
                    <div id="base-layers" style="display: none; padding: 10px; background: #f0f8f0; border-radius: 5px; transition: all 0.3s ease;">
                        <button onclick="toggleLayer()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">Toggle WMS Layer</button>
                        <button onclick="toggleSatellite()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">Satélite Base</button>
                        <button onclick="toggleRadar()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">REDEMET Realçada</button>
                        <button onclick="toggleCanal16()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">Canal 16 CPTEC</button>
                        <button onclick="toggleAnimation()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">Animação</button>
                        <button onclick="toggleCanal16Animation()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">Animação Canal 16</button>
                    </div>
                </div>

        <!-- Seção Análise Convecção -->
        <div class="section" style="flex: 1; min-width: 180px; max-width: 22%;">
            <button onclick="toggleSection('convection-controls')" style="background: #FF5722; color: white; border: none; padding: 4px 8px; border-radius: 6px; cursor: pointer; margin-bottom: 4px; width: 100%; font-size: 11px;">
                🌩️ Convecção ▼
            </button>
            <div id="convection-controls" style="display: none; padding: 10px; background: #fff3f0; border-radius: 5px; transition: all 0.3s ease;">
                <button onclick="analyzeConvectionHSV('SEVERA')" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🔴 HSV Severa</button>
                <button onclick="analyzeConvectionHSV('FORTE')" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🟣 HSV Forte</button>
                <button onclick="analyzeConvectionHSV('MODERADA')" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🟢 HSV Moderada</button>
                <button onclick="analyzeSigmetCopilot()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🤖 SIGMET Copilot</button>
                <button onclick="analyzeConvectionHSVSimple('SEVERA')" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🔴 HSV Simple</button>
                <button onclick="analyzeRealcadaHSV()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🌫️ HSV Realçada</button>
                <button onclick="processTransparentImage()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🔍 Fundo Transparente</button>
                <button onclick="analyzeHSVOptimized()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🔥 HSV Otimizado</button>
                <button onclick="analyzeHSVPolygons()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🔷 HSV Polígonos</button>
                <button onclick="showConvectionPolygons()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">📐 Polígonos HSV</button>
                <button onclick="showConvectionPolygons('SEVERA')" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">📐🔴 Polígonos Severos</button>
            </div>
        </div>

        <!-- Seção Ferramentas -->
        <div class="section" style="flex: 1; min-width: 180px; max-width: 22%;">
            <button onclick="toggleSection('tools-controls')" style="background: #9C27B0; color: white; border: none; padding: 4px 8px; border-radius: 6px; cursor: pointer; margin-bottom: 4px; width: 100%; font-size: 11px;">
                🎯 Ferramentas ▼
            </button>
            <div id="tools-controls" style="display: none; padding: 10px; background: #f8f0ff; border-radius: 5px; transition: all 0.3s ease;">
                <button onclick="zoomToExtent()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">Zoom Full</button>
                <button onclick="measureDistance()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">Medir Distância</button>
                <button onclick="drawPolygon()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">Desenhar Polígono</button>
                <button id="sigmetBtn" class="sigmet-btn" onclick="toggleSigmets()" style="width: 49%; margin: 2px 1%; padding: 3px; font-size: 10px;">SIGMETs Válidos</button>
                <button id="sigmetAllBtn" class="sigmet-btn" onclick="toggleAllSigmets()" style="width: 49%; margin: 2px 0; padding: 3px; font-size: 10px;">Todos SIGMETs</button>
                <button id="sigmetVizinhosBtn" onclick="toggleSigmetsVizinhos()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px; background:#FF6600; color:#fff; border:none; border-radius:3px; cursor:pointer;">🌎 SIGMETs Vizinhos</button>
                <button id="airmetBtn" onclick="toggleAirmets()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px; background:#E8820C; color:#fff; border:none; border-radius:3px; cursor:pointer;">⚠️ AIRMETs Válidos</button>

                <button id="top200SBBtn" class="metar-btn" onclick="toggleTop200SB()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">Top 200 SB</button>
                <button onclick="toggleSigmetPolygons()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🎯 Polígonos SIGMET</button>
                <button id="cancelPolygonsBtn" onclick="cancelSelectedPolygons()" style="display: none; background: #dc3545; color: white; width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">❌ Cancelar Polígonos</button>
                <button onclick="loadSevereConvectionSigmet()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">⚡ SIGMET Convecção Severa</button>
                <button onclick="toggleFirLayer()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🛩️ FIRs Brasil</button>
                <button id="graticuleBtn" onclick="toggleGraticule()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">🌐 Grade Lat/Lon</button>
                <button onclick="toggleSection('sigwx-controls')" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px; background:#607d8b; color:white; border:none; border-radius:3px; cursor:pointer;">🌐 SigWx WAFS ▼</button>
                <div id="sigwx-controls" style="display:none; padding:4px; background:#eceff1; border-radius:4px; margin:2px 0;">
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;">
                        <button onclick="navigateSigwx(-1)" id="sigwxPrevBtn" style="padding:2px 6px; font-size:11px; cursor:pointer;" disabled>◀</button>
                        <span id="sigwxCycleLabel" style="font-size:10px; font-family:monospace; flex:1; text-align:center;">—</span>
                        <span id="sigwxNewCycleBadge" onclick="applyNewSigwxCycle()" title="Novo ciclo disponível" style="display:none; cursor:pointer; font-size:11px; margin:0 4px;">🔄</span>
                        <button onclick="navigateSigwx(+1)" id="sigwxNextBtn" style="padding:2px 6px; font-size:11px; cursor:pointer;" disabled>▶</button>
                    </div>
                    <button id="sigwxBtn_CLOUD"          onclick="toggleSigwxTipo('CLOUD')"          style="width:100%; margin:1px 0; padding:3px; font-size:10px;">🔴 CB/Nuvens</button>
                    <button id="sigwxBtn_TURBULENCE"     onclick="toggleSigwxTipo('TURBULENCE')"     style="width:100%; margin:1px 0; padding:3px; font-size:10px;">🟡 Turbulência</button>
                    <button id="sigwxBtn_AIRFRAME_ICING" onclick="toggleSigwxTipo('AIRFRAME_ICING')" style="width:100%; margin:1px 0; padding:3px; font-size:10px;">🔵 Icing</button>
                    <button id="sigwxBtn_JETSTREAM"      onclick="toggleSigwxTipo('JETSTREAM')"      style="width:100%; margin:1px 0; padding:3px; font-size:10px;">🟠 Jetstream</button>
                    <button id="sigwxBtn_TROPOPAUSE"     onclick="toggleSigwxTipo('TROPOPAUSE')"     style="width:100%; margin:1px 0; padding:3px; font-size:10px;">🟢 Tropopausa</button>
                    <button id="sigwxBtn_VOLCANO"        onclick="toggleSigwxTipo('VOLCANO')"        style="width:100%; margin:1px 0; padding:3px; font-size:10px;">🟣 Vulcão</button>
                    <button id="sigwxBtn_TROPICAL_CYCLONE" onclick="toggleSigwxTipo('TROPICAL_CYCLONE')" style="width:100%; margin:1px 0; padding:3px; font-size:10px;">🌀 Ciclone Tropical</button>
                    <button onclick="clearAllSigwx()" style="width:100%; margin:1px 0; padding:3px; font-size:10px; background:#b71c1c; color:white; border:none; border-radius:3px; cursor:pointer;">✖ Limpar Tudo</button>
                </div>
                <button onclick="clearDrawings()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px;">Limpar Desenhos</button>
                <button id="btn-3d" onclick="toggle3D()" style="width: 100%; margin: 2px 0; padding: 3px; font-size: 10px; background:#1a237e; color:white; border:none; border-radius:3px; cursor:pointer;">🌐 Modo 3D</button>
            </div>
        </div>

        <!-- Seção Barbelas de Vento (mantida igual) -->
        <div class="wind-barbs-section" style="flex: 1; min-width: 180px; max-width: 22%;">
            <button id="windBarbsToggle" onclick="toggleWindBarbsSection()" style="background: #2196F3; color: white; border: none; padding: 4px 8px; border-radius: 6px; cursor: pointer; margin-bottom: 4px; width: 100%; font-size: 11px;">
                🌪️ GRIB2 ▼
            </button>
            <div id="wind-barbs-controls" style="display: none; padding: 10px; background: #f5f5f5; border-radius: 5px; transition: all 0.3s ease;">
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <select id="windLevelSelect" style="padding: 5px; border-radius: 3px;">
                        <option value="">Selecione o nível</option>
                        <option value="surface">Superfície (10m)</option>
                        <option value="fl050">FL050 (850mb - 5.000ft)</option>
                        <option value="fl100">FL100 (700mb - 10.000ft)</option>
                        <option value="fl180">FL180 (500mb - 18.000ft)</option>
                        <option value="fl240">FL240 (400mb - 24.000ft)</option>
                        <option value="fl300">FL300 (300mb - 30.000ft)</option>
                        <option value="fl390">FL390 (250mb - 39.000ft)</option>
                        <option value="fl450">FL450 (200mb - 45.000ft)</option>
                        <option value="fl530">FL530 (150mb - 53.000ft)</option>
                    </select>
                    <button id="loadWindBarbsBtn" onclick="loadWindBarbs()" 
                            style="background: #2196F3; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer;">
                        Carregar Barbelas
                    </button>
                    <button id="clearWindBarbsBtn" onclick="clearWindBarbs()" 
                            style="background: #f44336; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer;">
                        Limpar
                    </button>
                    <button onclick="toggleWindAnimation()" 
                            style="background: #4CAF50; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer;">
                        🎬 Animação
                    </button>
                    <button onclick="toggleRealcadaAnimation()" 
                            style="background: #FF9800; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer;">
                        🌈 Realçada
                    </button>
                    <span id="windBarbsStatus" style="margin-top: 5px; font-style: italic; color: #666; font-size: 12px;"></span>
                </div>
            </div>
        </div>
            </div>
        </div>
    </div>

    <!-- Container da Animação -->
    <div id="wind-animation-container" style="display: none;"></div>
    
    <!-- Container da Animação Realçada -->
    <div id="realcada-animation-container" style="display: none;"></div>
    
    <div id="sigmet-count-badge" style="position: absolute; top: 10px; right: 420px; background: rgba(0,0,0,0.7); color: #ff6b6b; padding: 3px 6px; border-radius: 3px; font-family: monospace; font-size: 11px; z-index: 1002; display:none; align-items:center; gap:4px;">
        ⚡ SIGMETs: <span id="sigmet-count-value"></span>
    </div>
    <div id="sigmet-vizinhos-badge" style="position: absolute; top: 30px; right: 420px; background: rgba(0,0,0,0.7); color: #FF6600; padding: 3px 6px; border-radius: 3px; font-family: monospace; font-size: 11px; z-index: 1002; display:none; align-items:center; gap:4px;">
        🌎 Vizinhos: <span id="sigmet-vizinhos-count"></span>
    </div>
    <div id="airmet-count-badge" style="position: absolute; top: 50px; right: 420px; background: rgba(0,0,0,0.7); color: #E8820C; padding: 3px 6px; border-radius: 3px; font-family: monospace; font-size: 11px; z-index: 1002; display:none; align-items:center; gap:4px;">
        ⚠️ AIRMETs: <span id="airmet-count-value"></span>
    </div>
    <div id="adwrng-count-badge" style="position: absolute; top: 90px; right: 420px; background: rgba(0,0,0,0.7); color: #FFD700; padding: 3px 6px; border-radius: 3px; font-family: monospace; font-size: 11px; z-index: 1002; align-items:center; gap:4px; display:none;">
        🏢 AD WRNGs: <span id="adwrng-count-value">0</span>
    </div>
    <div id="grib2-date-badge" style="position: absolute; top: 70px; right: 420px; background: rgba(0,0,0,0.7); color: #90caf9; padding: 3px 6px; border-radius: 3px; font-family: monospace; font-size: 11px; z-index: 1002; display:none; align-items:center; gap:4px;">
        📡 GRIB2: <span id="grib2-date-value"></span>
    </div>

    <div id="sigwx-cycle-label" style="position: absolute; top: 10px; right: 220px; background: rgba(0,0,0,0.7); color: #90caf9; padding: 3px 6px; border-radius: 3px; font-family: monospace; font-size: 11px; z-index: 1002; display:none; display:flex; align-items:center; gap:4px;">
        <button id="sigwxFloatPrev" onclick="navigateSigwx(-1)" style="background:none; border:none; color:#90caf9; cursor:pointer; font-size:11px; padding:0 2px;" disabled>◀</button>
        🌐 SigWx: <span id="sigwx-cycle-value"></span>
        <button id="sigwxFloatNext" onclick="navigateSigwx(+1)" style="background:none; border:none; color:#90caf9; cursor:pointer; font-size:11px; padding:0 2px;" disabled>▶</button>
    </div>

    <div id="mouse-position" style="position: absolute; top: 10px; right: 60px; background: rgba(0,0,0,0.7); color: white; padding: 5px; border-radius: 3px; font-family: monospace; z-index: 1002;"></div>
    
    <div id="map"></div>
    <div id="cesium-tooltip" style="display:none; position:fixed; z-index:9999; background:rgba(0,0,0,0.75); color:white; padding:8px 12px; border-radius:6px; font-size:12px; pointer-events:none;"></div>

    <div id="panel-3d" style="display:none; position:fixed; top:10px; right:10px; z-index:9998; background:rgba(20,20,40,0.92); color:white; padding:10px 14px; border-radius:8px; font-size:12px; min-width:160px; box-shadow:0 2px 8px rgba(0,0,0,0.5);">
        <div style="font-weight:bold; margin-bottom:8px; border-bottom:1px solid #555; padding-bottom:4px;">🌐 Layers 3D</div>
        <label style="display:flex;align-items:center;gap:6px;margin-bottom:5px;cursor:pointer;"><input type="checkbox" id="chk3d-fir"     checked onchange="_toggle3DLayer('fir',this.checked)">FIR</label>
        <label style="display:flex;align-items:center;gap:6px;margin-bottom:5px;cursor:pointer;"><input type="checkbox" id="chk3d-sigwx"   checked onchange="_toggle3DLayer('sigwx',this.checked)">SIGWX</label>
        <label style="display:flex;align-items:center;gap:6px;margin-bottom:5px;cursor:pointer;"><input type="checkbox" id="chk3d-sigmet"  checked onchange="_toggle3DLayer('sigmet',this.checked)">SIGMETs</label>
        <label style="display:flex;align-items:center;gap:6px;margin-bottom:5px;cursor:pointer;"><input type="checkbox" id="chk3d-vizinho" checked onchange="_toggle3DLayer('vizinho',this.checked)">Vizinhos</label>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;"><input type="checkbox" id="chk3d-grib2"   checked onchange="if(window._cesiumGrib2Billboards)window._cesiumGrib2Billboards.show=this.checked">GRIB2</label>
    </div>
    <div id="polygon-edit-controls" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:9999; background:white; padding:16px 20px; border-radius:8px; box-shadow:0 4px 20px rgba(0,0,0,0.4); text-align:center;">
        <div style="margin-bottom:10px; font-size:13px; font-weight:bold;">✏️ Edite os vértices e confirme</div>
        <button onclick="confirmPolygon()" style="padding:6px 16px; font-size:12px; background:#28a745; color:white; border:none; border-radius:4px; cursor:pointer; margin-right:8px;">✅ Confirmar</button>
        <button onclick="cancelPolygonEdit()" style="padding:6px 16px; font-size:12px; background:#dc3545; color:white; border:none; border-radius:4px; cursor:pointer;">❌ Cancelar</button>
    </div>
    
    <!-- Formulário SIGMET -->
    <div id="sigmetForm">
        <h3>📋 Formulário SIGMET</h3>
        
        <div class="form-group">
            <label>Coordenadas SIGMET:</label>
            <div id="coordsDisplay" class="coords-display"></div>
        </div>
        
        <div class="form-group">
            <label for="nivelSelect">Nível:</label>
            <select id="nivelSelect">
                <option value="SFC/100">SFC/100</option>
                <option value="SFC/120">SFC/120</option>
                <option value="SFC/150">SFC/150</option>
                <option value="100/200">100/200</option>
                <option value="150/250">150/250</option>
                <option value="200/300">200/300</option>
                <option value="250/400">250/400</option>
                <option value="300/450">300/450</option>
            </select>
        </div>
        
        <div class="form-group">
            <label for="fenomenoText">Estado do Fenômeno:</label>

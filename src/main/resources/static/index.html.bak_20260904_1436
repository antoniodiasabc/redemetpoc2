                    if (alt > 5000000) skip = 4;
                    else if (alt > 3000000) skip = 3;
                    else if (alt > 1500000) skip = 2;
                    console.log(`3D alt=${Math.round(alt)}m skip=${skip}`);
                } else {
                    const zoom = map.getView().getZoom();
                    if (zoom < 5) skip = 4;
                    else if (zoom < 6) skip = 3;
                    else if (zoom < 7) skip = 2;
                    console.log(`2D zoom=${zoom.toFixed(1)} skip=${skip}`);
                }
                
                const response = await fetch(`/api/wind/barbs/${level}?skip=${skip}&t=${Date.now()}`);
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const windData = await response.json();
                console.log(`✅ ${windData.length} barbelas carregadas (skip=${skip})`);
                
                // Limpar layer anterior
                if (windBarbsLayer) {
                    map.removeLayer(windBarbsLayer);
                }
                
                // Criar features das barbelas
                const features = windData.map(wind => createWindBarbFeature(wind));
                
                // Criar layer
                windBarbsLayer = new ol.layer.Vector({
                    source: new ol.source.Vector({
                        features: features
                    }),
                    style: function(feature) {
                        return createWindBarbStyle(feature.get('windData'));
                    },
                    zIndex: 1000
                });
                
                map.addLayer(windBarbsLayer);
                windBarbsVisible = true;

                // --- 3D: billboards Cesium ---
                if (ol3d && ol3d.getEnabled()) {
                    if (window._cesiumGrib2Billboards) {
                        ol3d.getCesiumScene().primitives.remove(window._cesiumGrib2Billboards);
                    }
                    const flMeters = { fl050:1524, fl100:3048, fl180:5486, fl240:7315, fl300:9144, fl390:11887, fl450:13716, fl530:16154 };
                    const alt = flMeters[level] || 9144;
                    const bb = new Cesium.BillboardCollection();
                    windData.forEach(wind => {
                        const lon = wind.lon > 180 ? wind.lon - 360 : wind.lon;
                        const canvas = document.createElement('canvas');
                        canvas.width = 40; canvas.height = 40;
                        drawWindBarbGrib(canvas.getContext('2d'), 20, 20, wind.speed, wind.direction);
                        bb.add({
                            position: Cesium.Cartesian3.fromDegrees(lon, wind.lat, alt),
                            image: canvas,
                            width: 40, height: 40,
                            verticalOrigin: Cesium.VerticalOrigin.CENTER
                        });
                    });
                    ol3d.getCesiumScene().primitives.add(bb);
                    window._cesiumGrib2Billboards = bb;
                }
                // --- fim 3D ---
                
                statusSpan.textContent = `✅ ${windData.length} barbelas (skip=${skip})`;
                statusSpan.style.color = '#4caf50';
                
                // Adicionar evento de click
                addWindBarbClickHandler();
                
            } catch (error) {
                console.error('❌ Erro carregando barbelas:', error);
                statusSpan.textContent = `❌ Erro: ${error.message}`;
                statusSpan.style.color = '#f44336';
            }
        }

        // Criar feature de barbela
        function createWindBarbFeature(windData) {
            const lon = windData.lon > 180 ? windData.lon - 360 : windData.lon;
            const coords = ol.proj.fromLonLat([lon, windData.lat]);
            
            const feature = new ol.Feature({
                geometry: new ol.geom.Point(coords),
                windData: windData
            });
            
            return feature;
        }

        // Criar estilo da barbela
        function createWindBarbStyle(windData) {
            const speed = windData.speed;
            const direction = windData.direction;
            
            // Criar canvas para desenhar barbela
            const canvas = document.createElement('canvas');
            canvas.width = 40;
            canvas.height = 40;
            const ctx = canvas.getContext('2d');
            
            // Desenhar barbela
            drawWindBarbGrib(ctx, 20, 20, speed, direction);
            
            return new ol.style.Style({
                image: new ol.style.Icon({
                    img: canvas,
                    imgSize: [40, 40],
                    anchor: [0.5, 0.5]
                })
            });
        }

        // Desenhar barbela no canvas
        // Barbela GRIB2 (usa ctx diretamente)
        function drawWindBarbGrib(ctx, x, y, speed, direction) {
            ctx.strokeStyle = '#000'; ctx.lineWidth = 2; ctx.lineCap = 'round';
            if (speed < 2) { ctx.beginPath(); ctx.arc(x, y, 6, 0, 2*Math.PI); ctx.stroke(); return; }
            const angle = (direction - 90) * Math.PI / 180;
            const endX = x + 18*Math.cos(angle), endY = y + 18*Math.sin(angle);
            ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(endX, endY); ctx.stroke();
            ctx.beginPath(); ctx.arc(x, y, 3, 0, 2*Math.PI); ctx.fillStyle='#000'; ctx.fill();
            let spd = speed, pos = 1.0;
            while (spd >= 50) {
                const px=x+(endX-x)*pos, py=y+(endY-y)*pos, pa=angle+Math.PI/2;
                ctx.beginPath(); ctx.moveTo(px,py); ctx.lineTo(px-8*Math.cos(angle),py-8*Math.sin(angle)); ctx.lineTo(px+12*Math.cos(pa),py+12*Math.sin(pa)); ctx.closePath(); ctx.fillStyle='#000'; ctx.fill();
                spd-=50; pos-=0.25;
            }
            while (spd >= 10) {
                const px=x+(endX-x)*pos, py=y+(endY-y)*pos, pa=angle+Math.PI/2;
                ctx.beginPath(); ctx.moveTo(px,py); ctx.lineTo(px+12*Math.cos(pa),py+12*Math.sin(pa)); ctx.stroke();
                spd-=10; pos-=0.15;
            }
            if (spd >= 5) {
                const px=x+(endX-x)*pos, py=y+(endY-y)*pos, pa=angle+Math.PI/2;
                ctx.beginPath(); ctx.moveTo(px,py); ctx.lineTo(px+6*Math.cos(pa),py+6*Math.sin(pa)); ctx.stroke();
            }
        }

        // Limpar barbelas
        function clearWindBarbs() {
            if (windBarbsLayer) {
                map.removeLayer(windBarbsLayer);
                windBarbsLayer = null;
                windBarbsVisible = false;
                document.getElementById('windBarbsStatus').textContent = '';
            }
            if (window._cesiumGrib2Billboards && ol3d) {
                ol3d.getCesiumScene().primitives.remove(window._cesiumGrib2Billboards);
                window._cesiumGrib2Billboards = null;
            }
        }

        // Adicionar click handler para barbelas
        function addWindBarbClickHandler() {
            map.on('click', function(evt) {
                if (!windBarbsVisible) return;
                
                const feature = map.forEachFeatureAtPixel(evt.pixel, function(feature, layer) {
                    if (layer === windBarbsLayer) return feature;
                });
                
                if (feature) {
                    const windData = feature.get('windData');
                    showWindBarbPopup(evt.coordinate, windData);
                }
            });
        }

        // Mostrar popup da barbela
        function showWindBarbPopup(coordinate, windData) {
            const popup = new ol.Overlay({
                element: document.createElement('div'),
                autoPan: true,
                autoPanAnimation: { duration: 250 }
            });
            
            const element = popup.getElement();
            const lon = windData.lon > 180 ? windData.lon - 360 : windData.lon;
            
            element.innerHTML = `
                <div style="background: white; padding: 15px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.3); max-width: 300px; font-family: Arial;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <strong style="font-size: 16px;">🌪️ Vento ${windData.level.toUpperCase()}</strong>
                        <button onclick="this.parentElement.parentElement.parentElement.remove()" style="background: none; border: none; font-size: 18px; cursor: pointer;">×</button>
                    </div>
                    <div style="margin-bottom: 8px;">📍 ${windData.lat.toFixed(2)}°, ${lon.toFixed(2)}°</div>
                    <div style="margin-bottom: 8px; font-weight: bold;">🧭 Direção: ${windData.direction.toFixed(0)}°</div>
                    <div style="margin-bottom: 8px; font-weight: bold;">💨 Velocidade: ${windData.speed.toFixed(1)} nós</div>
                    <div style="font-family: monospace; font-size: 12px;">U: ${windData.u.toFixed(2)} m/s | V: ${windData.v.toFixed(2)} m/s</div>
                </div>
            `;
            
            popup.setPosition(coordinate);
            map.addOverlay(popup);
        }

        // Função para processar imagem com fundo transparente
        let transparentLayer = null;
        
        function processTransparentImage() {
            console.log('Processando imagem com fundo transparente...');
            
            // Se já existe, remove
            if (transparentLayer) {
                map.removeLayer(transparentLayer);
                transparentLayer = null;
                console.log('🗑️ Layer transparente removida');
                return;
            }
            
            fetch('/make_transparent', {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                console.log('Resposta:', data);
                
                if (data.status === 'success') {
                    transparentLayer = new ol.layer.Image({
                        source: new ol.source.ImageStatic({
                            url: data.image + '?' + Date.now(),
                            imageExtent: ol.proj.transformExtent([-118.52, -53.2, -24.09, 38.8], 'EPSG:4326', 'EPSG:3857'),
                            attributions: 'REDEMET Realçada - Fundo Transparente'
                        }),
                        opacity: 0.8
                    });
                    
                    map.addLayer(transparentLayer);
                    console.log('✅ Imagem transparente criada e adicionada!');
                } else {
                    console.error('❌ Erro: ' + (data.error || 'Erro desconhecido'));
                }
            })
            .catch(error => {
                console.error('Erro:', error);
                alert('❌ Erro ao processar imagem transparente');
            });
        }
    </script>
    

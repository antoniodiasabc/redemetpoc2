        async function navigateSigwx(direction) {
            const next = sigwxCycleIndex + direction;
            if (next < 0 || next >= sigwxCycleWindow.length) return;
            if (!sigwxCycleWindow[next].available) return;
            const tiposAtivos = Object.keys(sigwxLayers);
            sigwxCycleIndex = next;
            // limpa layers mas não o cache
            tiposAtivos.forEach(tipo => {
                map.removeLayer(sigwxLayers[tipo]);
                delete sigwxLayers[tipo];
                const btn = document.getElementById('sigwxBtn_' + tipo);
                if (btn) { btn.style.fontWeight = ''; btn.style.outline = ''; }
            });
            updateCycleUI();
            // recarrega os tipos que estavam ativos no novo ciclo
            for (const tipo of tiposAtivos) await toggleSigwxTipo(tipo);
        }

        async function getSigwxGeoJson() {
            const entry = sigwxCycleWindow[sigwxCycleIndex];
            const filename = entry ? entry.filename : null;
            if (filename && sigwxGeoJsonCache.has(filename)) return sigwxGeoJsonCache.get(filename);
            const url = filename ? `/api/v1/sigwx/file?name=${encodeURIComponent(filename)}` : '/api/v1/sigwx/current';
            const resp = await fetch(url);
            if (!resp.ok) throw new Error('SigWx não disponível');
            const data = await resp.json();
            if (filename) sigwxGeoJsonCache.set(filename, data);
            return data;
        }

        async function toggleSigwxTipo(tipo) {
            const btn = document.getElementById('sigwxBtn_' + tipo);
            if (sigwxLayers[tipo]) {
                map.removeLayer(sigwxLayers[tipo]);
                delete sigwxLayers[tipo];
                btn.style.fontWeight = '';
                btn.style.outline = '';
                if (tipo === 'TURBULENCE') { const l = document.getElementById('turbLegend'); if (l) l.remove(); }
                return;
            }
            try {
                const geojson = await getSigwxGeoJson();
                const filtered = {
                    type: 'FeatureCollection',
                    features: geojson.features.filter(f => f.properties.type === tipo)
                };
                if (filtered.features.length === 0) { alert('Nenhum ' + tipo + ' neste ciclo.'); return; }

                const c = SIGWX_COLORS[tipo] || SIGWX_COLORS['CLOUD'];

                const layer = new ol.layer.Vector({
                    source: new ol.source.Vector({
                        features: new ol.format.GeoJSON().readFeatures(filtered, { featureProjection: 'EPSG:3857' })
                    }),
                    style: function(feature) {
                        const geomType = feature.getGeometry().getType();
                        const sub = feature.get('subtype');

                        // --- JETSTREAM linha com setas múltiplas ---
                        if (geomType === 'LineString' && sub === 'line') {
                            const coords = feature.getGeometry().getCoordinates();
                            const styles = [new ol.style.Style({
                                stroke: new ol.style.Stroke({ color: '#000000', width: 3 })
                            })];
                            // seta a cada ~400px de comprimento de linha
                            const step = Math.max(1, Math.floor(coords.length / 4));
                            for (let i = step; i < coords.length; i += step) {
                                const p = coords[i], pp = coords[i-1];
                                const dx = p[0]-pp[0], dy = p[1]-pp[1];
                                const angle = Math.atan2(dy, dx);
                                styles.push(new ol.style.Style({
                                    geometry: new ol.geom.Point(p),
                                    image: new ol.style.RegularShape({
                                        fill: new ol.style.Fill({ color: '#000000' }),
                                        points: 3, radius: 7,
                                        rotation: -angle + Math.PI / 2
                                    })
                                }));
                            }
                            return styles;
                        }

                        // --- JETSTREAM barbela de vento ---

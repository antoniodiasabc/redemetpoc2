        function formatLatitudeToSigmet(lat) {
            const isNorth = lat >= 0;
            const absLat = Math.abs(lat);
            const degrees = Math.floor(absLat);
            const minutes = Math.round((absLat - degrees) * 60);
            const prefix = isNorth ? 'N' : 'S';
            return `${prefix}${degrees.toString().padStart(2, '0')}${minutes.toString().padStart(2, '0')}`;
        }

        function formatLongitudeToSigmet(lon) {
            const isEast = lon >= 0;
            const absLon = Math.abs(lon);
            const degrees = Math.floor(absLon);
            const minutes = Math.round((absLon - degrees) * 60);
            const prefix = isEast ? 'E' : 'W';
            return `${prefix}${degrees.toString().padStart(3, '0')}${minutes.toString().padStart(2, '0')}`;
        }

        function copyPolygonPointsSigmet(coordsJson) {
            const coords = JSON.parse(coordsJson);
            const sigmetLine = coords.map(coord => {
                const latSigmet = formatLatitudeToSigmet(coord[1]);
                const lonSigmet = formatLongitudeToSigmet(coord[0]);
                return `${latSigmet} ${lonSigmet}`;
            }).join(' - ');
            
            navigator.clipboard.writeText(sigmetLine);
            console.log('Coordenadas SIGMET copiadas!');
        }


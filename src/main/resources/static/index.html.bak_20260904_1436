        /** Cache de barbelas por velocidade+cor */
        const _barbCache = {};
        function drawWindBarb(kt, color, lat, bearing) {
            // lado das barbelas: sempre do lado do polo (cross product vento x polo)
            let side = -1; // default esquerda
            if (lat !== undefined && bearing !== undefined) {
                const bx = Math.sin(bearing), by = Math.cos(bearing);
                const py = lat >= 0 ? 1 : -1;
                const cross = bx * py - by * 0;
                side = cross > 0 ? -1 : 1;
            }
            const key = kt + '_' + color + '_' + side;
            if (_barbCache[key]) return _barbCache[key];

            const c = document.createElement('canvas');
            c.width = 40; c.height = 40;
            const ctx = c.getContext('2d');
            if (!ctx) return '';
            ctx.strokeStyle = color;
            ctx.fillStyle = color;
            ctx.lineWidth = 1.5;

            const cx = 20, base = 38, top = 8;
            ctx.beginPath(); ctx.moveTo(cx, base); ctx.lineTo(cx, top); ctx.stroke();

            let rem = kt, y = top;
            while (rem >= 50) {
                ctx.beginPath(); ctx.moveTo(cx, y); ctx.lineTo(cx + 14*side, y+3); ctx.lineTo(cx, y+10); ctx.closePath(); ctx.fill();
                y += 12; rem -= 50;
            }
            while (rem >= 10) {
                ctx.beginPath(); ctx.moveTo(cx, y); ctx.lineTo(cx + 12*side, y-3); ctx.stroke();
                y += 5; rem -= 10;
            }
            if (rem >= 5) { ctx.beginPath(); ctx.moveTo(cx, y); ctx.lineTo(cx + 6*side, y-2); ctx.stroke(); }
            if (kt < 5)   { ctx.beginPath(); ctx.arc(cx, base-4, 4, 0, 2*Math.PI); ctx.stroke(); }

            _barbCache[key] = c.toDataURL();
            return _barbCache[key];
        }


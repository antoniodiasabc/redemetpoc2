            hidePolygonTooltip();
        }

        function updateFeatureProperties(feature) {
            const geometry = feature.getGeometry();
            const coords = geometry.getCoordinates()[0];
            
            // Converter para lat/lon
            const geoCoords = coords.map(coord => ol.proj.toLonLat(coord));
            
            // Atualizar propriedades
            feature.set('pointCount', geoCoords.length);
            feature.set('area', calculatePolygonArea(geoCoords));
        }

        function showPolygonTooltip(feature, coordinate) {
            const geometry = feature.getGeometry();
            const coords = geometry.getCoordinates()[0];
            const geoCoords = coords.map(coord => ol.proj.toLonLat(coord));
            
            const severity = feature.get('severity');
            const area = feature.get('area');
            const pointCount = geoCoords.length;
            const flightLevel = calculateFlightLevel(severity, area);
            
            // Converter coordenadas para formato SIGMET
            let sigmetCoords = '';
            geoCoords.forEach((coord, index) => {
                const latSigmet = formatLatitudeToSigmet(coord[1]);
                const lonSigmet = formatLongitudeToSigmet(coord[0]);
                sigmetCoords += `${latSigmet} ${lonSigmet}`;
                if (index < geoCoords.length - 1) sigmetCoords += ' - ';
            });
            
            const tooltipContent = `
                <div style="min-width: 400px;">
                    <h3>📐 Polígono Editável</h3>
                    <p><strong>Severidade:</strong> ${severity.toUpperCase()}</p>
                    <p><strong>Flight Level:</strong> ${flightLevel}</p>
                    <p><strong>Área:</strong> ${Math.round(area)} km²</p>
                    <p><strong>Pontos:</strong> ${pointCount}</p>
                    <hr>
                    <h4>📍 Coordenadas SIGMET:</h4>
                    <div style="max-height: 150px; overflow-y: auto; font-family: monospace; font-size: 12px; background: #f5f5f5; padding: 8px; border-radius: 4px;">
                        ${sigmetCoords}
                    </div>
                    <br>
                    <button onclick="sendSigmetMessage('${JSON.stringify(geoCoords)}', '${severity}', '${flightLevel}')" style="background: #007cba; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer;">📤 Enviar SIGMET</button>
                    <button onclick="copyPolygonCoords('${sigmetCoords}')" style="background: #28a745; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; margin-left: 5px;">📋 Copiar</button>
                    <button onclick="hidePolygonTooltip()" style="background: #dc3545; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; margin-left: 5px;">❌ Fechar</button>
                </div>
            `;
            
            // Criar tooltip
            if (window.polygonEditTooltip) {
                map.removeOverlay(window.polygonEditTooltip);
            }
            
            window.polygonEditTooltip = new ol.Overlay({
                element: document.createElement('div'),

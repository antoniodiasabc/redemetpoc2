                console.log('🎯 Layer da feature:', layer);
                console.log('🎯 É sigmetPolygonLayer?', layer === sigmetPolygonLayer);
                return feature;
            });
        });

        // Debug da seleção
        sigmetSelect.on('select', function(e) {
            console.log('🔥 SELECT EVENT DISPARADO!');
            console.log('🔍 Event completo:', e);
            console.log('🔍 Selected features:', e.selected);
            console.log('🔍 Deselected features:', e.deselected);
            
            const count = sigmetSelect.getFeatures().getLength();
            console.log(`🎯 TOTAL SELECIONADOS: ${count}`);
            
            // Debug do botão
            const cancelBtn = document.getElementById('cancelPolygonsBtn');
            console.log('🔍 Botão encontrado:', cancelBtn);
            
            if (cancelBtn) {
                if (count > 0) {
                    cancelBtn.style.display = 'inline-block';
                    cancelBtn.textContent = `❌ Cancelar ${count} polígono(s)`;
                    console.log('✅ BOTÃO MOSTRADO');
                } else {
                    cancelBtn.style.display = 'none';
                    console.log('❌ BOTÃO ESCONDIDO');
                }
            } else {
                console.log('❌ BOTÃO NÃO ENCONTRADO!');
            }
        });

        // Função para cancelar polígonos selecionados
        function cancelSelectedPolygons() {
            const selectedFeatures = sigmetSelect.getFeatures();
            console.log(`🗑️ Removendo ${selectedFeatures.getLength()} polígono(s)`);
            
            if (selectedFeatures.getLength() > 0) {
                // Remover de TODOS os layers
                selectedFeatures.forEach(feature => {
                    console.log('🗑️ Removendo feature:', feature);
                    
                    // Procurar em todos os layers do mapa
                    map.getLayers().forEach(layer => {
                        if (layer instanceof ol.layer.Vector) {
                            const source = layer.getSource();
                            if (source && source.hasFeature && source.hasFeature(feature)) {
                                source.removeFeature(feature);
                                console.log('✅ Feature removida do layer:', layer);
                            }
                        }
                    });
                });
                
                // Limpar seleção
                selectedFeatures.clear();
                // Esconder botão
                document.getElementById('cancelPolygonsBtn').style.display = 'none';
                console.log('✅ Todos os polígonos removidos do mapa');
            }
        }

        // Controles
        function toggleLayer() {
            wmsLayer.setVisible(!wmsLayer.getVisible());
        }

        function toggleSatellite() {
            satelliteLayer.setVisible(!satelliteLayer.getVisible());
        }

        function toggleWeather() {
            weatherLayer.setVisible(!weatherLayer.getVisible());
        }

        function toggleRadar() {
            if (radarLayer.getVisible()) {
                radarLayer.setVisible(false);
            } else {
                // Atualizar imagem com timestamp para evitar cache
                const newSource = new ol.source.ImageStatic({
                    url: '/realcada?' + Date.now(),
                    imageExtent: ol.proj.transformExtent([-99.75, -55, -25.25, 20], 'EPSG:4326', 'EPSG:3857'),
                    attributions: 'REDEMET/DECEA Realçada'
                });
                radarLayer.setSource(newSource);
                radarLayer.setVisible(true);
            }
        }

        function toggleCptec() {
            cptecLayer.setVisible(!cptecLayer.getVisible());
        }

        async function toggleCanal16() {
            if (canal16Layer.getVisible()) {
                canal16Layer.setVisible(false);
            } else {
                // Buscar frame mais recente antes de mostrar
                try {
                    const response = await fetch('/canal16frames');
                    const data = await response.json();
                    const frames = Array.isArray(data) ? data : (data.frames || []);
                    
                    if (frames.length > 0) {
                        // Usar frame mais recente
                        const latestFrame = frames[frames.length - 1];
                        const latestFrameUrl = `/canal16frame/${latestFrame}`;
                        
                        const latestSource = new ol.source.ImageStatic({
                            url: latestFrameUrl,
                            imageExtent: ol.proj.transformExtent([-118.52, -53.2, -24.09, 38.8], 'EPSG:4326', 'EPSG:3857'),
                            attributions: 'CPTEC/INPE Canal 16 (Mais Recente)'
                        });
                        canal16Layer.setSource(latestSource);
                        console.log('Canal 16 ativado com frame mais recente:', latestFrame);
                    } else {
                        // Fallback para imagem estática
                        const originalSource = new ol.source.ImageStatic({
                            url: '/canal16',
                            imageExtent: ol.proj.transformExtent([-118.52, -53.2, -24.09, 38.8], 'EPSG:4326', 'EPSG:3857'),
                            attributions: 'CPTEC/INPE Canal 16'
                        });
                        canal16Layer.setSource(originalSource);
                        console.log('Canal 16 ativado com imagem estática (fallback)');
                    }
                } catch (error) {
                    console.error('Erro ao buscar frames do Canal 16:', error);
                    // Fallback para imagem estática em caso de erro
                    const originalSource = new ol.source.ImageStatic({
                        url: '/canal16',
                        imageExtent: ol.proj.transformExtent([-118.52, -53.2, -24.09, 38.8], 'EPSG:4326', 'EPSG:3857'),
                        attributions: 'CPTEC/INPE Canal 16'
                    });
                    canal16Layer.setSource(originalSource);
                }
                
                canal16Layer.setVisible(true);
            }
        }

        async function toggleSigmetPolygons() {
            if (sigmetPolygonLayer.getVisible()) {
                sigmetPolygonLayer.setVisible(false);
            } else {
                // Recarregar GeoJSON antes de mostrar
                try {
                    const newSource = new ol.source.Vector({
                        url: 'risk_polygons.geojson?t=' + Date.now(), // Cache bust

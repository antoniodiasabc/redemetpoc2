        function findPolygonContainingPoint(point, features) {
            for (let feature of features) {
                if (feature.geometry.type === 'Polygon') {
                    if (isPointInPolygon(point, feature.geometry.coordinates[0])) {
                        return feature;
                    }
                }
            }
            return null;
        }

        function isPointInPolygon(point, polygon) {
            const x = point[0], y = point[1];
            let inside = false;
            
            for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
                const xi = polygon[i][0], yi = polygon[i][1];
                const xj = polygon[j][0], yj = polygon[j][1];
                
                if (((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi)) {
                    inside = !inside;
                }
            }
            
            return inside;
        }

        function calculatePolygonCenter(coords) {
            let sumLat = 0, sumLon = 0;
            coords.forEach(coord => {
                sumLon += coord[0];
                sumLat += coord[1];
            });
            return [sumLon / coords.length, sumLat / coords.length];
        }

        function calculateFlightLevel(severity, area) {
            // Cálculo baseado na severidade e área da convecção
            let baseFL, topFL;
            
            switch(severity.toLowerCase()) {
                case 'severa':
                    // Convecção severa: -80°C ou mais frio = FL450+
                    baseFL = area > 1000 ? 350 : 300;  // Base mais alta para áreas grandes
                    topFL = area > 2000 ? 500 : 450;   // Topo muito alto para células grandes
                    break;
                    
                case 'forte':
                    // Convecção forte: -60 a -80°C = FL350-450
                    baseFL = area > 800 ? 300 : 250;
                    topFL = area > 1500 ? 450 : 400;
                    break;
                    
                case 'moderada':
                    // Convecção moderada: -40 a -60°C = FL250-350
                    baseFL = area > 500 ? 250 : 200;
                    topFL = area > 1000 ? 350 : 300;
                    break;
                    
                default:
                    baseFL = 200;
                    topFL = 300;
            }
            
            return `FL${baseFL.toString().padStart(3, '0')}/${topFL.toString().padStart(3, '0')}`;
        }

        function calculateDistance(coord1, coord2) {
            const dx = coord1[0] - coord2[0];
            const dy = coord1[1] - coord2[1];
            return Math.sqrt(dx * dx + dy * dy);
        }


                const props = feature.getProperties();
                const styles = [];
                
                // Círculo principal com cor da condição
                styles.push(new ol.style.Style({
                    image: new ol.style.Circle({
                        radius: 8,
                        fill: new ol.style.Fill({
                            color: props.color || '#808080'
                        })
                    }),
                    text: new ol.style.Text({
                        text: props.icao,
                        font: '12px Arial',
                        fill: new ol.style.Fill({ color: '#000' }),
                        stroke: new ol.style.Stroke({ color: '#FFF', width: 2 }),
                        offsetY: -20
                    })
                }));
                
                // Se tem aviso, adicionar hachuras SOBRE a cor
                if (props.hasAviso) {
                    function createHatchPattern() {
                        const canvas = document.createElement('canvas');
                        canvas.width = 8;
                        canvas.height = 8;
                        const ctx = canvas.getContext('2d');
                        
                        ctx.clearRect(0, 0, 8, 8);
                        ctx.strokeStyle = props.color === '#FF0000' ? '#FFFFFF' : '#FF0000';
                        ctx.lineWidth = 1;
                        ctx.beginPath();
                        // Só linhas diagonais simples
                        ctx.moveTo(0, 4);
                        ctx.lineTo(8, 4);
                        ctx.moveTo(4, 0);
                        ctx.lineTo(4, 8);
                        ctx.stroke();
                        
                        return ctx.createPattern(canvas, 'repeat');
                    }
                    
                    styles.push(new ol.style.Style({
                        image: new ol.style.Circle({
                            radius: 8,
                            fill: new ol.style.Fill({
                                color: createHatchPattern()
                            })
                        })
                    }));
                }
                
                // Círculo laranja externo APENAS se for SPECI
                if (props.isSpeci) {
                    styles.push(new ol.style.Style({
                        image: new ol.style.Circle({
                            radius: 10,
                            fill: new ol.style.Fill({
                                color: 'transparent'
                            }),
                            stroke: new ol.style.Stroke({
                                color: '#FFA500',
                                width: 4
                            })
                        })
                    }));
                }
                
                return styles;
            },
            visible: false
        });

        const map = new ol.Map({
            target: 'map',
            layers: [osmLayer, satelliteLayer, weatherLayer, radarLayer, cptecLayer, wmsLayer, canal16Layer, sigmetPolygonLayer, sigmetLayer, airmetLayer, sigmetVizinhosLayer, metarLayer, measureLayer],
            view: new ol.View({
                center: ol.proj.fromLonLat([-47.9, -15.8]), // Brasília
                zoom: 5
            })
        });

        // Adicionar coordenadas no mapa
        const mousePositionControl = new ol.control.MousePosition({
            coordinateFormat: ol.coordinate.createStringXY(4),
            projection: 'EPSG:4326',
            className: 'custom-mouse-position',
            target: document.getElementById('mouse-position'),
            undefinedHTML: '&nbsp;'
        });
        map.addControl(mousePositionControl);

        // Hover tooltip nos SIGMETs
        const SIGWX_LABELS = {
            'CLOUD':          'CB / Nuvens Convectivas',
            'TURBULENCE':     'Turbulência',
            'AIRFRAME_ICING': 'Icing (Gelo na Aeronave)',
            'JETSTREAM':      'Jetstream',
            'TROPOPAUSE':     'Tropopausa',
            'VOLCANO':        'Atividade Vulcânica',
            'TROPICAL_CYCLONE': 'Ciclone Tropical'
        };

        map.on('pointermove', function(evt) {
            const feature = map.forEachFeatureAtPixel(evt.pixel, function(feature, layer) {
                if (layer === sigmetLayer) return feature;
            });

            let airmetFeature = null;
            if (!feature) {
                map.forEachFeatureAtPixel(evt.pixel, function(f, layer) {
                    if (layer === airmetLayer) { airmetFeature = f; return f; }
                });
            }

            let vizinhosFeature = null;
            if (!feature && !airmetFeature) {
                map.forEachFeatureAtPixel(evt.pixel, function(f, layer) {
                    if (layer === sigmetVizinhosLayer) { vizinhosFeature = f; return f; }
                });
            }
            
            // verifica também layers SigWx
            let sigwxFeature = null;
            if (!feature && !airmetFeature && !vizinhosFeature) {
                map.forEachFeatureAtPixel(evt.pixel, function(f, layer) {
                    if (Object.values(sigwxLayers).includes(layer)) { sigwxFeature = f; return f; }
                });
            }
            
            if (feature) {
                const props = feature.getProperties();
                const pixel = map.getEventPixel(evt.originalEvent);
                
                sigmetTooltip.innerHTML = `
                    <div style="color: ${props.color || '#FF6B35'}; font-weight: bold; margin-bottom: 5px;">
                        ⚡ SIGMET ${props.sigmetNumber} - ${props.sigmetType}
                    </div>
                    <div><strong>FIR:</strong> ${props.fir}</div>
                    <div><strong>Período:</strong> ${props.validPeriod}</div>
                `;
                
                sigmetTooltip.style.left = (pixel[0] + 15) + 'px';
                sigmetTooltip.style.top = (pixel[1] - 10) + 'px';
                sigmetTooltip.style.display = 'block';
                
                map.getTargetElement().style.cursor = 'pointer';
            } else if (airmetFeature) {
                const props = airmetFeature.getProperties();
                const pixel = map.getEventPixel(evt.originalEvent);
                // Extrai fenômeno do texto: tudo entre "FIR " e " FCST"
                const text = props.text || '';
                const fenMatch = text.match(/FIR\s+(.+?)\s+FCST/);
                const fenomeno = fenMatch ? fenMatch[1] : '';
                sigmetTooltip.innerHTML = `
                    <div style="color:#E8820C; font-weight:bold; margin-bottom:5px;">
                        ⚠️ AIRMET ${props.airmetNumber}
                    </div>
                    <div><strong>FIR:</strong> ${props.fir}</div>
                    <div><strong>Fenômeno:</strong> ${fenomeno}</div>
                    <div><strong>Período:</strong> ${props.validPeriod}</div>
                `;
                sigmetTooltip.style.left = (pixel[0] + 15) + 'px';
                sigmetTooltip.style.top = (pixel[1] - 10) + 'px';
                sigmetTooltip.style.display = 'block';
                map.getTargetElement().style.cursor = 'pointer';
                
                sigmetTooltip.style.left = (pixel[0] + 15) + 'px';
                sigmetTooltip.style.top = (pixel[1] - 10) + 'px';
                sigmetTooltip.style.display = 'block';
                
                map.getTargetElement().style.cursor = 'pointer';
            } else if (sigwxFeature) {
                const p = sigwxFeature.getProperties();
                const pixel = map.getEventPixel(evt.originalEvent);
                const c = SIGWX_COLORS[p.type] || SIGWX_COLORS['CLOUD'];
                const nivel = (p.flLower && p.flUpper) ? `FL${p.flLower} – FL${p.flUpper}` : (p.flUpper ? `até FL${p.flUpper}` : '');
                const vento = p.windSpeedKt ? `<div><strong>Vento:</strong> ${p.windSpeedKt} kt</div>` : '';
                const flLabel = p.fl ? `<div><strong>FL:</strong> ${p.fl}</div>` : (nivel ? `<div><strong>Nível:</strong> ${nivel}</div>` : '');
                const isoLabel = (p.flLower && p.flUpper && p.subtype === 'barb') ? `<div><strong>Isotaca:</strong> FL${p.flLower}–FL${p.flUpper}</div>` : '';
                const nameLabel = p.name ? `<div><strong>Nome:</strong> ${p.name}</div>` : '';
                const cbLabel = p.cloudDist ? `<div><strong>Dist:</strong> ${p.cloudDist==='7'||p.cloudDist==='8'?'FRQ':'OCNL'} CB</div>` : '';
                sigmetTooltip.innerHTML = `
                    <div style="color:${c.stroke}; font-weight:bold; margin-bottom:4px;">
                        🌐 ${SIGWX_LABELS[p.type] || p.type}
                    </div>
                    ${flLabel}${vento}${isoLabel}${nameLabel}${cbLabel}
                `;
                sigmetTooltip.style.left = (pixel[0] + 15) + 'px';
                sigmetTooltip.style.top = (pixel[1] - 10) + 'px';
                sigmetTooltip.style.display = 'block';
                map.getTargetElement().style.cursor = 'pointer';
            } else if (vizinhosFeature) {
                const props = vizinhosFeature.getProperties();
                const pixel = map.getEventPixel(evt.originalEvent);
                sigmetTooltip.innerHTML = `
                    <div style="color:${props.color||'#FF6600'}; font-weight:bold; margin-bottom:4px;">
                        🌎 SIGMET ${props.sigmetNumber} - ${props.sigmetType}
                    </div>
                    <div><strong>FIR:</strong> ${props.fir}</div>
                    <div><strong>Período:</strong> ${props.validPeriod}</div>
                    <div style="font-size:9px; color:#aaa; margin-top:3px;">${props.text ? props.text.substring(0,120)+'...' : ''}</div>
                `;
                sigmetTooltip.style.left = (pixel[0] + 15) + 'px';
                sigmetTooltip.style.top  = (pixel[1] - 10) + 'px';
                sigmetTooltip.style.display = 'block';
                map.getTargetElement().style.cursor = 'pointer';
            } else {
                sigmetTooltip.style.display = 'none';
                map.getTargetElement().style.cursor = '';
            }
        });

        // Esconder tooltip quando sair do mapa
        map.getTargetElement().addEventListener('mouseleave', function() {
            sigmetTooltip.style.display = 'none';
        });

        // Seleção múltipla de polígonos SIGMET
        // Debug completo da seleção
        console.log('🚀 Iniciando setup de seleção SIGMET');
        console.log('📍 sigmetPolygonLayer:', sigmetPolygonLayer);
        console.log('📍 sigmetPolygonLayer visível:', sigmetPolygonLayer.getVisible());
        console.log('📍 sigmetPolygonLayer source:', sigmetPolygonLayer.getSource());

        const sigmetSelect = new ol.interaction.Select({
            // Filtrar apenas polígonos SIGMET (não FIRs do Brasil)
            filter: function(feature, layer) {
                const geom = feature.getGeometry();
                if (!geom || geom.getType() !== 'Polygon') {
                    return false; // Só polígonos
                }
                
                const props = feature.getProperties();
                // Verificar se tem propriedades específicas de SIGMET
                return props.sigmet || props.sigmetNumber || props.fir || props.sigmetType || props.text;
            },
            multi: true,
            condition: ol.events.condition.click,
            addCondition: ol.events.condition.platformModifierKeyOnly,
            style: new ol.style.Style({
                stroke: new ol.style.Stroke({
                    color: '#00FF00',  // Verde brilhante
                    width: 8           // Largura 8
                }),
                fill: new ol.style.Fill({
                    color: 'rgba(0, 255, 0, 0.3)' // Verde transparente
                })
            })
        });
        
        console.log('🎯 Select interaction criado:', sigmetSelect);
        map.addInteraction(sigmetSelect);
        console.log('✅ Select interaction adicionado ao mapa');

        // Click no mapa para debug
        map.on('click', function(evt) {
            console.log('🖱️ CLICK NO MAPA:', evt.coordinate);
            
            const features = map.getFeaturesAtPixel(evt.pixel);
            console.log('🔍 Features no pixel:', features);
            
            map.forEachFeatureAtPixel(evt.pixel, function(feature, layer) {

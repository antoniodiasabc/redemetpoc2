                stopEvent: false,
                offset: [0, -10]
            });
            
            window.polygonEditTooltip.getElement().innerHTML = tooltipContent;
            window.polygonEditTooltip.getElement().className = 'ol-popup';
            window.polygonEditTooltip.setPosition(coordinate);
            map.addOverlay(window.polygonEditTooltip);
        }

        function hidePolygonTooltip() {
            if (window.polygonEditTooltip) {
                map.removeOverlay(window.polygonEditTooltip);
                window.polygonEditTooltip = null;
            }
        }

        function copyPolygonCoords(sigmetCoords) {

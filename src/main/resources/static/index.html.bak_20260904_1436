        const SIGWX_COLORS = {
            'CLOUD':          { stroke: '#cc0000', fill: 'rgba(204,0,0,0.25)' },
            'TURBULENCE':     { stroke: '#000000', fill: 'rgba(0,0,0,0)' },
            'AIRFRAME_ICING': { stroke: '#0055cc', fill: 'rgba(0,85,204,0.25)' },
            'JETSTREAM':      { stroke: '#000000', fill: 'rgba(0,0,0,0.1)' },
            'TROPOPAUSE':     { stroke: '#009900', fill: 'rgba(0,153,0,0.15)' },
            'VOLCANO':        { stroke: '#800080', fill: 'rgba(128,0,128,0.4)' },
            'TROPICAL_CYCLONE': { stroke: '#ff0000', fill: 'rgba(255,0,0,0.3)' }
        };

        // cache do geojson por filename
        const sigwxGeoJsonCache = new Map();
        // janela de ciclos recebida do backend
        let sigwxCycleWindow = [];
        let sigwxCycleIndex = 0;
        // layers ativas por tipo
        const sigwxLayers = {};

        async function loadSigwxList() {
            try {
                const resp = await fetch('/api/v1/sigwx/list');
                if (!resp.ok) return;
                sigwxCycleWindow = await resp.json();
                sigwxCycleIndex = sigwxCycleWindow.findIndex(e => e.current);
                if (sigwxCycleIndex < 0) sigwxCycleIndex = sigwxCycleWindow.findIndex(e => e.available);
                if (sigwxCycleIndex < 0) sigwxCycleIndex = 0;
                updateCycleUI();
            } catch(e) {}
        }

        // Checagem periódica: se o current do backend mudou, avisa o usuário
        let sigwxNewCycleFilename = null;
        setInterval(async () => {
            if (sigwxCycleWindow.length === 0) return; // painel nunca foi aberto
            try {
                const resp = await fetch('/api/v1/sigwx/list');
                if (!resp.ok) return;
                const newWindow = await resp.json();
                const newCurrent = newWindow.find(e => e.current);
                const oldCurrent = sigwxCycleWindow.find(e => e.current);
                sigwxCycleWindow = newWindow; // sempre atualiza a lista completa
                if (newCurrent && oldCurrent && newCurrent.filename !== oldCurrent.filename) {
                    sigwxNewCycleFilename = newCurrent.filename;
                    const badge = document.getElementById('sigwxNewCycleBadge');
                    if (badge) { badge.style.display = 'inline'; badge.title = 'Novo ciclo: ' + newCurrent.label; }
                }
            } catch(e) {}
        }, 5 * 60 * 1000); // checa a cada 5 minutos

        function applyNewSigwxCycle() {
            if (!sigwxNewCycleFilename) return;
            sigwxNewCycleFilename = null;
            const badge = document.getElementById('sigwxNewCycleBadge');
            if (badge) badge.style.display = 'none';
            loadSigwxList();
        }

        function updateCycleUI() {
            const entry = sigwxCycleWindow[sigwxCycleIndex];
            document.getElementById('sigwxCycleLabel').textContent = entry ? entry.label : '—';
            const atStart = sigwxCycleIndex <= 0;
            const atEnd   = sigwxCycleIndex >= sigwxCycleWindow.length - 1;
            document.getElementById('sigwxPrevBtn').disabled    = atStart;
            document.getElementById('sigwxNextBtn').disabled    = atEnd;
            document.getElementById('sigwxFloatPrev').disabled  = atStart;
            document.getElementById('sigwxFloatNext').disabled  = atEnd;
            if (entry) {
                document.getElementById('sigwx-cycle-value').textContent = entry.label;
                document.getElementById('sigwx-cycle-label').style.display = 'flex';

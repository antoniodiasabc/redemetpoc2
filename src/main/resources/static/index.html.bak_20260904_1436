                    }),
                    stroke: new ol.style.Stroke({
                        color: '#00FFFF',
                        width: 3
                    })
                })
            });
            
            // Modify interaction (editar vértices)
            const modify = new ol.interaction.Modify({
                features: select.getFeatures()
            });
            
            // Translate interaction (arrastar polígono inteiro)
            const translate = new ol.interaction.Translate({
                features: select.getFeatures()
            });
            
            // Adicionar interactions ao mapa
            map.addInteraction(select);
            map.addInteraction(modify);
            map.addInteraction(translate);
            console.log('✅ Select, Modify e Translate adicionados ao mapa');
            
            // Guardar referências para remoção posterior
            editInteractions.push(select, modify, translate);
            console.log('✅ Interações salvas:', editInteractions.length);
            
            // Event listeners
            select.on('select', function(e) {
                if (e.selected.length > 0) {
                    const feature = e.selected[0];
                    showPolygonTooltip(feature, e.mapBrowserEvent.coordinate);
                } else {
                    hidePolygonTooltip();
                }
            });
            
            modify.on('modifyend', function(e) {
                // Atualizar tooltip após modificação
                const feature = e.features.getArray()[0];
                if (feature) {
                    updateFeatureProperties(feature);
                }
            });
        }

        function removeEditInteractions() {
            editInteractions.forEach(interaction => {
                map.removeInteraction(interaction);

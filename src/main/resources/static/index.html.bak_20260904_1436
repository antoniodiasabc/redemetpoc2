        function calculateOffset(event) {
            console.log('🎯 calculateOffset chamado!', event);
            const feature = event.features.getArray()[0];
            const featureId = feature.getId() || 0;
            
            console.log('🔍 Feature ID:', featureId);
            console.log('🔍 Original positions:', originalPositions.size);
            
            if (originalPositions.has(featureId)) {
                const original = originalPositions.get(featureId);
                const newGeometry = feature.getGeometry();
                const newCenter = ol.extent.getCenter(newGeometry.getExtent());
                
                // Calcular diferença em coordenadas do mapa (EPSG:3857)
                const deltaX = newCenter[0] - original.center[0];
                const deltaY = newCenter[1] - original.center[1];
                
                // Converter para lat/lon
                const originalLatLon = ol.proj.toLonLat(original.center);
                const newLatLon = ol.proj.toLonLat(newCenter);
                
                const offsetLon = newLatLon[0] - originalLatLon[0];
                const offsetLat = newLatLon[1] - originalLatLon[1];
                
                console.log('📏 OFFSET CALCULADO:');
                console.log('  Longitude:', offsetLon.toFixed(6));
                console.log('  Latitude:', offsetLat.toFixed(6));
                console.log('  Pixels (aprox):', Math.abs(deltaX) + Math.abs(deltaY));
                
                // Salvar offset global
                window.calculatedOffset = { lon: offsetLon, lat: offsetLat };
                
                alert(`📏 OFFSET CALCULADO!\nLon: ${offsetLon.toFixed(6)}\nLat: ${offsetLat.toFixed(6)}\n\nVerifique o console para mais detalhes.`);
            }
        }

        // FUNÇÃO APLICAR OFFSET
        function applyOffset() {
            if (!window.calculatedOffset) {

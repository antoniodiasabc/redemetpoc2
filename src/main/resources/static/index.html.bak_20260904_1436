<script>
(function() {
    const PHENOMENA_LABEL = { WS:'Wind Shear', GR:'Granizo', TS:'Trovoada', '-TS':'Trovoada Fraca', '+TS':'Trovoada Forte', TSRA:'Trovoada+Chuva', '-TSRA':'Trovoada+Chuva Fraca', '+TSRA':'Trovoada+Chuva Forte', TSGR:'Trovoada+Granizo', '-TSGR':'Trovoada+Granizo Fraco', '+TSGR':'Trovoada+Granizo Forte', TSGS:'Trovoada+Granizo Pequeno', '+TSGS':'Trovoada+Granizo Pequeno Forte', SHRA:'Chuva de Convecção', '-SHRA':'Chuva de Convecção Fraca', '+SHRA':'Chuva de Convecção Forte', RA:'Chuva', '-RA':'Chuva Fraca', '+RA':'Chuva Forte', FG:'Nevoeiro', FZFG:'Nevoeiro Congelante', BR:'Névoa' };
    let minimized = false;

    document.getElementById('metar-alert-header').addEventListener('click', () => {
        minimized = !minimized;
        document.getElementById('metar-alert-body').style.display = minimized ? 'none' : 'block';
        document.getElementById('metar-alert-toggle').textContent = minimized ? '▲' : '▼';
    });

    // Drag
    const panel = document.getElementById('metar-alert-panel');
    const header = document.getElementById('metar-alert-header');
    let dragging = false, ox = 0, oy = 0;
    header.addEventListener('mousedown', e => {
        dragging = true;
        ox = e.clientX - panel.getBoundingClientRect().left;
        oy = e.clientY - panel.getBoundingClientRect().top;
        e.preventDefault();
    });
    document.addEventListener('mousemove', e => {
        if (!dragging) return;
        panel.style.left = (e.clientX - ox) + 'px';
        panel.style.top  = (e.clientY - oy) + 'px';
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';
    });
    document.addEventListener('mouseup', () => dragging = false);

    async function fetchAlerts() {
        try {
            const res = await fetch('/api/v1/alerts/metar?t=' + Date.now());
            const alerts = await res.json();
            const count = document.getElementById('metar-alert-count');
            const body = document.getElementById('metar-alert-body');
            count.textContent = alerts.length;

            if (alerts.length === 0) {
                body.innerHTML = '<div style="color:#888;text-align:center;padding:10px;">Nenhum alerta ativo</div>';
                return;
            }

            body.innerHTML = alerts.map(a => {
                const labels = a.phenomena.split(',').map(p => {
                    if (/^G\d+KT$/.test(p)) return `Rajada ${p.replace('G','').replace('KT','')}kt`;
                    return PHENOMENA_LABEL[p] || p;
                }).join(', ');
                const dt = a.metarTime || '------Z';
                return `<div style="border-left:3px solid #ff8c00;padding:5px 8px;margin-bottom:5px;background:#2a1a00;border-radius:0 4px 4px 0;">
                    <div style="color:#ff8c00;font-weight:bold;">${a.icao} <span style="color:#aaa;font-size:11px;">${dt}</span></div>
                    <div style="color:#ffd080;font-size:11px;">${labels}</div>
                    <div style="color:#ccc;font-size:10px;margin-top:2px;word-break:break-all;">${a.metarText}</div>
                </div>`;
            }).join('');
        } catch(e) { console.error('Erro alertas METAR:', e); }
    }

    fetchAlerts();
    setInterval(fetchAlerts, 30000);

    // Badge AD WRNGs — atualiza a cada 2 minutos
    async function fetchAdWrngCount() {
        try {
            const r = await fetch('/avisos_aerodromos_count');
            const d = await r.json();
            const badge = document.getElementById('adwrng-count-badge');
            const val = document.getElementById('adwrng-count-value');
            val.textContent = d.count;
            badge.style.display = d.count > 0 ? 'flex' : 'none';
        } catch(e) {}
    }
    fetchAdWrngCount();
    setInterval(fetchAdWrngCount, 120000);
})();
</script>

<script>
// ── Modo 3D (Cesium + ol-cesium) ─────────────────────────────────────────────
let ol3d = null;

async function toggle3D() {
    const btn = document.getElementById('btn-3d');
    if (!ol3d) {
        const token = await fetch('/api/v1/config/cesium-token').then(r => r.text());
        Cesium.Ion.defaultAccessToken = token;
        ol3d = new olcs.OLCesium({ map: map });
        ol3d.getCesiumScene().globe.enableLighting = false;
        // forçar Bing Maps Aerial como imagery
        ol3d.getCesiumScene().globe.imageryLayers.removeAll();
        ol3d.getCesiumScene().globe.imageryLayers.addImageryProvider(
            await Cesium.IonImageryProvider.fromAssetId(2)
        );
        ol3d.setEnabled(true);
        // centraliza no Brasil
        ol3d.getCesiumScene().camera.flyTo({
            destination: Cesium.Cartesian3.fromDegrees(-52, -15, 8000000)
        });
        await plotSigwx3D();
        btn.textContent = '🗺️ Modo 2D';
        document.getElementById('panel-3d').style.display = 'block';
        return;
    }
    const enabled = !ol3d.getEnabled();
    ol3d.setEnabled(enabled);
    btn.textContent = enabled ? '🗺️ Modo 2D' : '🌐 Modo 3D';
    document.getElementById('panel-3d').style.display = enabled ? 'block' : 'none';
}

function _toggle3DLayer(key, visible) {
    if (window._cesium3DLayers && window._cesium3DLayers[key] !== undefined)
        window._cesium3DLayers[key].show = visible;
}

async function plotSigwx3D() {
    const scene = ol3d.getCesiumScene();
    window._cesiumFeatureProps = [];

    // limpar layers anteriores
    if (window._cesium3DLayers) {
        Object.values(window._cesium3DLayers).forEach(c => scene.primitives.remove(c));
    }
    window._cesium3DLayers = {
        fir:     scene.primitives.add(new Cesium.PrimitiveCollection()),
        sigmet:  scene.primitives.add(new Cesium.PrimitiveCollection()),
        vizinho: scene.primitives.add(new Cesium.PrimitiveCollection()),
        sigwx:   scene.primitives.add(new Cesium.PrimitiveCollection()),
        labels:  scene.primitives.add(new Cesium.LabelCollection())
    };

    const [sigwx, sigmets, vizinhos, firsData] = await Promise.all([
        fetch('/api/v1/sigwx/current').then(r => r.json()).catch(() => ({features:[]})),
        fetch('/redemet_sigmets_json').then(r => r.json()).catch(() => []),
        fetch('/redemet_sigmets_vizinhos').then(r => r.json()).catch(() => []),
        fetch('/firs').then(r => r.json()).catch(() => ({features:[]}))
    ]);

    const allFeatures = [
        ...sigwx.features.map(f => ({...f, _src:'sigwx'})),
        ...sigmets.map(f => ({...f, _src:'sigmet'})),
        ...vizinhos.map(f => ({...f, _src:'vizinho'})),
        ...firsData.features.map(f => ({...f, _src:'fir'}))
    ];

    const labels = window._cesium3DLayers.labels;
    let count = 0;

    allFeatures.forEach(f => {
        try {
            if (!f.geometry || f.geometry.type !== 'Polygon') return;
            const p = f.properties || {};
            const src = f._src;
            const isFir = src === 'fir';
            const col = window._cesium3DLayers[src];

            const baseM = isFir ? 0 : (parseFloat(p.flLower || p.base_fl || 0)) * 30.48;
            let topFl = p.flUpper || p.top_fl || 0;
            if (!topFl && p.text) { const m = p.text.match(/TOP FL(\d+)/); if (m) topFl = m[1]; }
            const topM = isFir ? 100 : (parseFloat(topFl) || 300) * 30.48;

            const fillColor = isFir ? Cesium.Color.WHITE.withAlpha(0.05)
                : src === 'sigmet'  ? Cesium.Color.RED.withAlpha(0.25)
                : src === 'vizinho' ? Cesium.Color.ORANGE.withAlpha(0.25)
                : cesiumColorByType(p.type, p.cloudType).withAlpha(0.25);

            const outlineColor = isFir ? Cesium.Color.YELLOW
                : src === 'sigmet'  ? Cesium.Color.RED
                : src === 'vizinho' ? Cesium.Color.ORANGE
                : cesiumColorByType(p.type, p.cloudType);

            const ring = f.geometry.coordinates[0];
            const positions = Cesium.Cartesian3.fromDegreesArray(ring.flat());

            col.add(new Cesium.Primitive({
                geometryInstances: new Cesium.GeometryInstance({
                    id: count,
                    geometry: new Cesium.PolygonGeometry({
                        polygonHierarchy: new Cesium.PolygonHierarchy(positions),
                        extrudedHeight: topM, height: baseM
                    }),
                    attributes: { color: Cesium.ColorGeometryInstanceAttribute.fromColor(fillColor) }
                }),
                appearance: new Cesium.PerInstanceColorAppearance({ translucent: true })
            }));

            col.add(new Cesium.Primitive({
                geometryInstances: new Cesium.GeometryInstance({
                    geometry: new Cesium.PolygonOutlineGeometry({
                        polygonHierarchy: new Cesium.PolygonHierarchy(positions),
                        extrudedHeight: topM, height: baseM
                    }),
                    attributes: { color: Cesium.ColorGeometryInstanceAttribute.fromColor(outlineColor) }
                }),
                appearance: new Cesium.PerInstanceColorAppearance({ flat: true, translucent: false })
            }));

            const lons = ring.map(c => c[0]), lats = ring.map(c => c[1]);
            const cLon = lons.reduce((a,b)=>a+b,0)/lons.length;
            const cLat = lats.reduce((a,b)=>a+b,0)/lats.length;
            const labelText = isFir ? (p.ident || p.name || '') + ' ' + (p.nam || '')
                : src === 'sigmet'  ? `SIGMET ${p.sigmetNumber||''}\n${p.fir||''} ${p.sigmetType||''}`
                : src === 'vizinho' ? `SIGMET VIZ\n${p.fir||''} ${p.sigmetType||''}`
                : `${p.type||''}${p.cloudType==='9'?' CB':''}\nFL${p.flLower||'0'}-${p.flUpper||'---'}`;

            labels.add({
                position: Cesium.Cartesian3.fromDegrees(cLon, cLat, topM + (isFir ? 50000 : 5000)),
                text: labelText,
                font: isFir ? 'bold 14px sans-serif' : 'bold 12px sans-serif',
                fillColor: Cesium.Color.BLACK,
                outlineColor: Cesium.Color.WHITE,
                outlineWidth: 0,
                style: Cesium.LabelStyle.FILL,
                verticalOrigin: Cesium.VerticalOrigin.BOTTOM,
                scaleByDistance: new Cesium.NearFarScalar(1e5, 1.2, 8e6, 0.4),
                id: count
            });

            window._cesiumFeatureProps.push({ props: p, baseM, topM, src });
            count++;
        } catch(e) { console.warn('3D feature error:', e.message); }
    });

    console.log(`plotSigwx3D: ${count} polígonos plotados`);

    const handler = new Cesium.ScreenSpaceEventHandler(scene.canvas);
    handler.setInputAction(click => {
        const picked = scene.pick(click.position);
        if (picked && picked.id !== undefined && window._cesiumFeatureProps[picked.id]) {
            const { props: p, topM, src } = window._cesiumFeatureProps[picked.id];
            const label = src === 'fir' ? `<b>FIR ${p.ident || p.name}</b> ${p.nam || ''}`
                : src === 'sigmet'  ? `<b>SIGMET ${p.sigmetNumber||''}</b><br>${p.fir||''} — ${p.sigmetType||''}<br>${p.validPeriod||''}`
                : src === 'vizinho' ? `<b>SIGMET Vizinho</b><br>${p.fir||''} — ${p.sigmetType||''}<br>${p.validPeriod||''}`
                : `<b>${p.type||''}${p.cloudType==='9'?' (CB)':''}</b><br>FL${p.flLower||'000'} → FL${p.flUpper||'---'}`;
            show3DTooltip(label, click.position);
        } else { hide3DTooltip(); }
    }, Cesium.ScreenSpaceEventType.LEFT_CLICK);
}

function show3DTooltip(html, position) {
    const el = document.getElementById('cesium-tooltip');
    el.innerHTML = html;
    el.style.left = (position.x + 12) + 'px';
    el.style.top  = (position.y - 10) + 'px';
    el.style.display = 'block';
}
function hide3DTooltip() {
    document.getElementById('cesium-tooltip').style.display = 'none';
}

function cesiumColorByType(type, cloudType) {
    if (type === 'CLOUD' && cloudType === '9') return Cesium.Color.RED.withAlpha(0.4);
    if (type === 'TURBULENCE')    return Cesium.Color.ORANGE.withAlpha(0.4);
    if (type === 'AIRFRAME_ICING') return Cesium.Color.BLUE.withAlpha(0.4);
    if (type === 'JETSTREAM')     return Cesium.Color.YELLOW.withAlpha(0.5);
    if (type === 'TROPOPAUSE')    return Cesium.Color.GREEN.withAlpha(0.3);
    return Cesium.Color.GRAY.withAlpha(0.3);
}
</script>


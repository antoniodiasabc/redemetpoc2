        // REDEMET - Realçada (voltando coordenadas que funcionavam)
        const radarLayer = new ol.layer.Image({
            source: new ol.source.ImageStatic({
                url: '/realcada?' + Date.now(),
                imageExtent: ol.proj.transformExtent([-99.75, -55, -25.25, 20], 'EPSG:4326', 'EPSG:3857'),
